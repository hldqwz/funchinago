---
// src/pages/about.astro
import Layout from "../layouts/Layout.astro";
import { useTranslations } from "../i18n";

const locale = "en";
const t = useTranslations(locale);
---

<Layout title={t("about.title")} lang={locale}>
  <div class="container-narrow" style="padding-top: 2rem; padding-bottom: 3rem;">
    <h1 style="font-size: 1.65rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 1.5rem;">
      {t("about.title")}
    </h1>

    <p style="font-size: 1rem; color: var(--text-secondary); margin-bottom: 2rem;">
      {t("about.intro")}
    </p>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem;">{t("about.what")}</h2>
      <p style="color: var(--text-secondary); line-height: 1.8;">{t("about.what_text")}</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem;">{t("about.sources")}</h2>
      <p style="color: var(--text-secondary); line-height: 1.8;">{t("about.sources_text")}</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem;">{t("about.why")}</h2>
      <p style="color: var(--text-secondary); line-height: 1.8;">{t("about.why_text")}</p>
    </section>

    <section style="margin-bottom: 2rem;">
      <h2 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem;">{t("about.who")}</h2>
      <p style="color: var(--text-secondary); line-height: 1.8;">{t("about.who_text")}</p>
    </section>
  </div>
</Layout>
