---
import Layout from '../../../layouts/ChinaTravelLayout.astro';
import { getCollection, render } from 'astro:content';
import sourceRegistry from '../../../data/chinaTravelSources.json';
import { formatTravelStage } from '../../../data/chinaTravelPresentation';

function articleSlug(id: string) {
  return id.replace(/\.md$/, '');
}

export async function getStaticPaths() {
  const articles = await getCollection('china-travel');
  return articles.map((article) => ({ params: { slug: article.id.replace(/\.md$/, '') } }));
}

const { slug } = Astro.params;
const allArticles = await getCollection('china-travel');
const article = allArticles.find((entry) => articleSlug(entry.id) === slug);

if (!article) {
  return Astro.redirect('/china-travel/articles/', 301);
}

const { Content } = await render(article);

type SourceEntry = (typeof sourceRegistry.sources)[number];

const sources: SourceEntry[] = article.data.officialSources
  .map((id) => sourceRegistry.sources.find((source) => source.id === id))
  .filter((source): source is SourceEntry => Boolean(source));

/* --------------------------------------------------------------------------
   核验时间戳：等宽 + 大写月份，读起来像「流程记录」而不是「营销文案」
   -------------------------------------------------------------------------- */
const MONTH_LABELS = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];

function formatStamp(value: Date | string | undefined) {
  if (!value) return '—';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '—';
  const day = String(date.getUTCDate()).padStart(2, '0');
  return `${day} ${MONTH_LABELS[date.getUTCMonth()]} ${date.getUTCFullYear()}`;
}

function formatLongDate(value: Date | string | undefined) {
  if (!value) return '—';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '—';
  return date.toLocaleDateString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' });
}

/* --------------------------------------------------------------------------
   时效 SLA
   政策类（stage=before，或带 visa / payment / transit 标签）→ 90 天
   其他（含城市类）→ 180 天
   超过阈值自动切换到警告变体：颜色转 --seal-line（赭），左侧 3px 竖线
   -------------------------------------------------------------------------- */
const POLICY_TAG = /(visa|payment|transit)/i;

const isPolicyTopic =
  article.data.stage === 'before' || article.data.tags.some((tag) => POLICY_TAG.test(tag));

const reviewCycleDays = isPolicyTopic ? 90 : 180;

const lastCheckedDate = new Date(article.data.lastChecked);
const daysSinceCheck = Math.max(
  0,
  Math.floor((Date.now() - lastCheckedDate.getTime()) / 86_400_000),
);
const daysRemaining = reviewCycleDays - daysSinceCheck;
const isOverdue = daysSinceCheck > reviewCycleDays;

const verifyState = isOverdue ? 'overdue' : 'current';

const ageLabel =
  daysSinceCheck === 0
    ? 'Checked today'
    : `Checked ${daysSinceCheck} day${daysSinceCheck === 1 ? '' : 's'} ago`;

const cycleLabel = isOverdue
  ? `Overdue by ${Math.abs(daysRemaining)} day${Math.abs(daysRemaining) === 1 ? '' : 's'}`
  : `${daysRemaining} day${daysRemaining === 1 ? '' : 's'} until next review`;

const primarySource = sources[0];

/* --------------------------------------------------------------------------
   相关文章
   -------------------------------------------------------------------------- */
const paymentRelatedBySlug: Record<string, string[]> = {
  'how-to-pay-in-china-tourist': [
    'how-to-use-alipay-in-china-foreigner',
    'how-to-use-wechat-pay-in-china-foreigner',
    'wechat-pay-vs-alipay-for-tourists-china',
  ],
  'how-to-use-alipay-in-china-foreigner': [
    'how-to-pay-in-china-tourist',
    'how-to-use-wechat-pay-in-china-foreigner',
    'alipay-not-working-in-china-foreign-tourists',
  ],
  'how-to-use-wechat-pay-in-china-foreigner': [
    'how-to-pay-in-china-tourist',
    'how-to-use-alipay-in-china-foreigner',
    'wechat-pay-not-working-in-china-foreigners',
  ],
  'can-you-use-apple-pay-or-google-pay-in-china': [
    'how-to-pay-in-china-tourist',
    'can-foreign-credit-cards-work-in-china',
    'wechat-pay-vs-alipay-for-tourists-china',
  ],
  'wechat-pay-vs-alipay-for-tourists-china': [
    'how-to-pay-in-china-tourist',
    'how-to-use-alipay-in-china-foreigner',
    'how-to-use-wechat-pay-in-china-foreigner',
  ],
};
const curatedRelatedSlugs = paymentRelatedBySlug[articleSlug(article.id)] ?? [];
const relatedArticles = curatedRelatedSlugs.length > 0
  ? curatedRelatedSlugs.flatMap((relatedSlug) => {
      const candidate = allArticles.find((entry) => articleSlug(entry.id) === relatedSlug);
      return candidate ? [candidate] : [];
    })
  : allArticles
      .filter((candidate) => candidate.id !== article.id)
      .map((candidate) => {
        let score = 0;
        if (candidate.data.section === article.data.section) score += 4;
        if (candidate.data.stage === article.data.stage) score += 2;
        const sharedTags = candidate.data.tags.filter((tag) => article.data.tags.includes(tag)).length;
        score += sharedTags * 3;
        return { candidate, score };
      })
      .filter(({ score }) => score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 3)
      .map(({ candidate }) => candidate);

const siteUrl = Astro.site ?? new URL("https://funchinago.com");
const articleUrl = new URL(`/china-travel/articles/${articleSlug(article.id)}/`, siteUrl).toString();
const articleImage = article.data.hero_image
  ? new URL(article.data.hero_image, siteUrl).toString()
  : undefined;

const orgId = new URL("/china-travel/", siteUrl).toString();

/* Google SERP 展示的是 dateModified，取 updatedAt 与 lastChecked 中较新的那个，
   否则搜索结果里的日期会停在旧的内容改动日，核验机制在最影响点击的位置失效 */
/* lastCheckedDate 已在上方右轨逻辑中声明，此处复用 */
const effectiveModified = lastCheckedDate > article.data.updatedAt ? lastCheckedDate : article.data.updatedAt;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.data.title,
  "description": article.data.description,
  "image": articleImage,
  "datePublished": article.data.date.toISOString(),
  "dateModified": effectiveModified.toISOString(),
  "lastReviewed": lastCheckedDate.toISOString(),
  "author": { "@type": "Organization", "@id": orgId, "name": "China Travel Made Easy" },
  "publisher": { "@type": "Organization", "@id": orgId, "name": "China Travel Made Easy" },
  "mainEntityOfPage": { "@type": "WebPage", "@id": articleUrl },
};

/* --------------------------------------------------------------------------
   页面级核验信息条（h1 + description 下方）
   固定格式：Last checked 17 Oct 2026 · 5 official sources · Updated when policy changes
   短月份标题体（Oct），与右轨的 17 OCT 2026 全大写记录体错开，读作「摘要」而非「日志」
   -------------------------------------------------------------------------- */
const META_MONTH_LABELS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

function formatMetaDate(value: Date | string | undefined) {
  if (!value) return '—';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return '—';
  return `${date.getUTCDate()} ${META_MONTH_LABELS[date.getUTCMonth()]} ${date.getUTCFullYear()}`;
}

const verifyCheckedLabel = formatMetaDate(article.data.lastChecked);
const verifySourceCount = article.data.officialSources.length;

/* --------------------------------------------------------------------------
   FAQPage JSON-LD
   content.config.ts 不在本文件改动范围，zod schema 会 strip 未定义的 faq 字段，
   因此不读 frontmatter，改为直接扫描原始正文（article.body）：
   匹配问号结尾的 H2/H3 标题，取其后的第一个段落作为答案，
   自动覆盖各篇已内置的 FAQ 小节；没有问号标题则不输出
   -------------------------------------------------------------------------- */
type FaqEntry = { question: string; answer: string };

function stripInlineMarkdown(text: string): string {
  return text
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/__([^_]+)__/g, '$1')
    .replace(/\*([^*]+)\*/g, '$1')
    .replace(/_([^_]+)_/g, '$1')
    .replace(/\s+/g, ' ')
    .trim();
}

function extractFaqEntries(body: string): FaqEntry[] {
  const lines = body.split('\n');
  const entries: FaqEntry[] = [];
  const seen = new Set<string>();

  for (let i = 0; i < lines.length; i += 1) {
    const heading = lines[i].match(/^#{2,3}\s+(.+?)\s*$/);
    if (!heading) continue;

    const question = stripInlineMarkdown(heading[1]);
    if (!question.endsWith('?')) continue;
    if (seen.has(question.toLowerCase())) continue;

    /* 答案只取标题后的第一个段落：空行结束，遇到列表 / 引用 / HTML 块即放弃该条 */
    const paragraph: string[] = [];
    for (let j = i + 1; j < lines.length; j += 1) {
      const line = lines[j].trim();
      if (line === '') {
        if (paragraph.length > 0) break;
        continue;
      }
      if (/^(#{1,6}\s|[-*+]\s|\d+\.\s|>|<)/.test(line)) break;
      paragraph.push(line);
    }

    const answer = stripInlineMarkdown(paragraph.join(' '));
    if (!answer) continue;

    seen.add(question.toLowerCase());
    entries.push({ question, answer });
  }

  return entries;
}

const faqEntries = extractFaqEntries(article.body);
const faqSchema = faqEntries.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqEntries.map((entry) => ({
        "@type": "Question",
        "name": entry.question,
        "acceptedAnswer": { "@type": "Answer", "text": entry.answer },
      })),
    }
  : null;

/* --------------------------------------------------------------------------
   HowTo JSON-LD
   仅对纯流程型文章输出；steps 从正文 Quick Answer / 60-Second 小节的
   <ol>（或 markdown 编号列表）提取，提取不到就跳过，不硬造
   -------------------------------------------------------------------------- */
const HOW_TO_SLUGS = new Set([
  'how-to-use-alipay-in-china-foreigner',
  'how-to-use-wechat-pay-in-china-foreigner',
  'how-to-pay-in-china-tourist',
  'can-you-use-apple-pay-or-google-pay-in-china',
]);

type HowToStep = { name: string; text: string };
type StepBlock = { heading: string; items: string[] };

function stripHtmlTags(html: string): string {
  return html
    .replace(/<[^>]+>/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}

function extractHtmlOrderedBlocks(body: string): StepBlock[] {
  const headings = [...body.matchAll(/^#{2,3}\s+(.+?)\s*$/gm)].map((match) => ({
    index: match.index ?? 0,
    text: stripInlineMarkdown(match[1]),
  }));

  return [...body.matchAll(/<ol\b[^>]*>([\s\S]*?)<\/ol>/gi)]
    .map((match) => {
      const start = match.index ?? 0;
      let heading = '';
      for (const entry of headings) {
        if (entry.index < start) heading = entry.text;
      }
      const items = [...match[1].matchAll(/<li\b[^>]*>([\s\S]*?)<\/li>/gi)].map((item) => item[1]);
      return { heading, items };
    })
    .filter((block) => block.items.length > 0);
}

function extractMarkdownOrderedBlocks(body: string): StepBlock[] {
  const lines = body.split('\n');
  const blocks: StepBlock[] = [];
  let current: string[] | null = null;
  let heading = '';

  const flush = () => {
    if (current && current.length > 0) blocks.push({ heading, items: current });
    current = null;
  };

  for (const line of lines) {
    const headingMatch = line.match(/^#{2,3}\s+(.+?)\s*$/);
    if (headingMatch) {
      flush();
      heading = stripInlineMarkdown(headingMatch[1]);
      continue;
    }
    const item = line.match(/^\s*\d+\.\s+(.+)$/);
    if (item) {
      if (!current) current = [];
      current.push(item[1]);
      continue;
    }
    if (line.trim() === '') continue;
    flush();
  }
  flush();

  return blocks;
}

function stepNameFrom(itemHtml: string, text: string): string {
  const lead = itemHtml.match(/<strong\b[^>]*>([\s\S]*?)<\/strong>/i);
  if (lead) {
    const cleaned = stripHtmlTags(lead[1]).replace(/\.\s*$/, '').trim();
    if (cleaned) return cleaned;
  }
  const firstSentence = text.split('. ')[0].replace(/\.\s*$/, '');
  return firstSentence.length > 90 ? `${firstSentence.slice(0, 87)}...` : firstSentence;
}

function extractHowToSteps(body: string): HowToStep[] {
  const blocks = [...extractHtmlOrderedBlocks(body), ...extractMarkdownOrderedBlocks(body)];
  /* 优先 Quick Answer / 60-Second / step 类小节，其次取全文第一个有序列表 */
  const preferred = blocks.find((block) => /quick answer|60-second|step/i.test(block.heading)) ?? blocks[0];
  if (!preferred) return [];

  const steps = preferred.items
    .map((item) => {
      /* markdown 编号列表里的链接语法先转成纯文本，避免 [文字](路径) 原样落进 JSON-LD */
      const text = stripHtmlTags(stripInlineMarkdown(item));
      return text ? { name: stepNameFrom(item, text), text } : null;
    })
    .filter((step): step is HowToStep => Boolean(step));

  /* 少于两步不构成流程，跳过 */
  return steps.length >= 2 ? steps : [];
}

const slugId = articleSlug(article.id);
const howToSteps = HOW_TO_SLUGS.has(slugId) ? extractHowToSteps(article.body) : [];
/* 白名单内的文章抽不到步骤时，HowTo schema 会静默变成 null；构建期提示一次，便于及时修正文或从白名单移除 */
if (HOW_TO_SLUGS.has(slugId) && howToSteps.length === 0) {
  console.warn(
    `[china-travel] HowTo whitelist miss: "${slugId}" produced 0 steps. Add an ordered list to the article or remove it from HOW_TO_SLUGS.`,
  );
}
const howToSchema = howToSteps.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": article.data.seoTitle ?? article.data.title,
      "description": article.data.description,
      "step": howToSteps.map((step, index) => ({
        "@type": "HowToStep",
        "position": index + 1,
        "name": step.name,
        "text": step.text,
      })),
    }
  : null;

/* Article 之外按需追加 FAQPage / HowTo，Layout 会各自渲染成独立的 ld+json script */
const structuredDataSchemas: Array<Record<string, unknown>> = [articleSchema];
if (faqSchema) structuredDataSchemas.push(faqSchema);
if (howToSchema) structuredDataSchemas.push(howToSchema);
---

<Layout
  title={article.data.seoTitle ?? article.data.title}
  description={article.data.description}
  ogImage={article.data.hero_image}
  pageType="article"
  jsonLd={structuredDataSchemas}
>
  <main class="article-shell">
    <div class="article-grid">
      <article class="article-main">
        <a class="back-link mono-meta" href="/china-travel/articles/">← All China Travel articles</a>

        <header class="article-header">
          <p class="stage mono-meta">{formatTravelStage(article.data.stage)}</p>
          <h1>{article.data.title}</h1>
          <p class="verify-strip mono-meta">
            <span class="verified-dot">Last checked {verifyCheckedLabel}</span>
            {' · '}
            {verifySourceCount} official sources
            {' · '}
            Updated when policy changes
          </p>
          <p class="description">{article.data.description}</p>
          <div class="meta mono-meta">
            <span class="verified-dot">VERIFIED {formatStamp(article.data.lastChecked)}</span>
            <span>Updated {formatLongDate(article.data.updatedAt)}</span>
          </div>
          {article.data.hero_image && (
            <img
              class="hero-image"
              src={article.data.hero_image}
              alt={article.data.hero_alt ?? `Hero image for ${article.data.title}`}
              width={article.data.hero_width}
              height={article.data.hero_height}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          )}
        </header>

        <aside class="accuracy-note">
          Policy-sensitive facts on this page are checked against the official sources listed in the right rail. Confirm visa, payment and ticketing details with the linked source before you travel.
        </aside>

        <div class="article-content">
          <Content />
        </div>
      </article>

      <aside class="article-rail" aria-label="Verification record and sources">
        {/* 1 ── 核验记录 */}
        <section class="rail-card verify-card" data-state={verifyState}>
          <h2 class="rail-title mono-meta">Verification record</h2>
          <p class="verify-line mono-meta"><span class="verified-dot">VERIFIED</span></p>
          <dl class="verify-grid mono-meta">
            <dt>Last checked</dt>
            <dd>{formatStamp(article.data.lastChecked)}</dd>
            <dt>Age</dt>
            <dd>{ageLabel}</dd>
            <dt>Review cycle</dt>
            <dd>{reviewCycleDays} days · {cycleLabel}</dd>
          </dl>
          {isOverdue && (
            <p class="verify-warning mono-meta">
              Past its review window. Open the sources below before relying on this page.
            </p>
          )}
        </section>

        {/* 2 ── 本篇溯源清单 */}
        {sources.length > 0 && (
          <section class="rail-card source-card">
            <h2 class="rail-title mono-meta">Sources behind this page</h2>
            <ol class="source-list">
              {sources.map((source) => (
                <li class="source-item">
                  <a class="source-link" href={source.url} target="_blank" rel="noreferrer noopener">
                    {source.title}
                  </a>
                  <p class="source-authority mono-meta">{source.authority}</p>
                  <p class="source-checked mono-meta">Last checked {formatStamp(source.lastChecked)}</p>
                  <p class="source-use">{source.useFor}</p>
                </li>
              ))}
            </ol>
            <a class="rail-link mono-meta" href="/china-travel/sources/">Open the full source library →</a>
          </section>
        )}

        {/* 3 ── 变更日志 */}
        {article.data.changelog.length > 0 && (
          <section class="rail-card changelog-card">
            <h2 class="rail-title mono-meta">Change log</h2>
            <ol class="changelog-list">
              {article.data.changelog.map((entry) => (
                <li class="changelog-item">
                  <p class="changelog-date mono-meta">{formatStamp(entry.date)}</p>
                  <p class="changelog-note">{entry.note}</p>
                </li>
              ))}
            </ol>
          </section>
        )}

        {/* 4 ── 相关工具 */}
        {article.data.relatedTools.length > 0 && (
          <section class="rail-card tool-card">
            <h2 class="rail-title mono-meta">Related tools</h2>
            <ul class="tool-list">
              {article.data.relatedTools.map((tool) => (
                <li><a class="tool-link" href={tool.href}>{tool.title} →</a></li>
              ))}
            </ul>
          </section>
        )}

        {/* 5 ── 更新日期 */}
        <section class="rail-card updated-card">
          <h2 class="rail-title mono-meta">Last updated</h2>
          <p class="updated-date mono-meta">{formatStamp(article.data.updatedAt)}</p>
          <p class="updated-note mono-meta">Content revision · source re-check tracked above</p>
          {article.data.reviewer && (
            <p class="updated-reviewer mono-meta">Reviewed by {article.data.reviewer}</p>
          )}
        </section>

        {/* ── 边注 Marginalia：悬挂在右栏外侧的小字 ── */}
        {primarySource && (
          <aside class="marginalia" aria-label="Field note">
            <p class="marginalia-label mono-meta">Field check</p>
            <p class="marginalia-body">{primarySource.useFor}</p>
          </aside>
        )}
      </aside>
    </div>

    {relatedArticles.length > 0 && (
      <section class="related-box">
        <div class="related-header">
          <h2>{curatedRelatedSlugs.length > 0 ? 'Related payment guides' : 'Keep planning from here'}</h2>
          <a class="related-archive" href="/china-travel/articles/">See all guides</a>
        </div>
        <div class="related-grid">
          {relatedArticles.map((related) => (
            <a class="related-card" href={`/china-travel/articles/${articleSlug(related.id)}/`}>
              {related.data.hero_image && <img src={related.data.hero_image} alt={`Cover image for ${related.data.title}`} loading="lazy" decoding="async" />}
              <div class="related-copy">
                <span>{formatTravelStage(related.data.stage)}</span>
                <h3>{related.data.title}</h3>
                <p>{related.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>

<style>
  /* ======================================================================
     骨架：12 栅格，正文 8 列 / 右轨 4 列
     ====================================================================== */
  .article-shell {
    background: var(--paper);
    padding: clamp(2rem, 5vw, 3.5rem) 1.25rem var(--space-tight);
    color: var(--ink);
  }

  .article-grid {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--grid-gap-lg);
    align-items: start;
  }

  .article-main {
    min-width: 0;
  }

  .article-rail {
    min-width: 0;
    display: grid;
    gap: var(--grid-gap);
  }

  @media (min-width: 1024px) {
    .article-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }

    .article-main {
      grid-column: 1 / span 8;
    }

    .article-rail {
      grid-column: 9 / span 4;
      position: sticky;
      top: 5.5rem;
      /* padding-left 为边注的左悬挂留出空间，避免负边距触发横向滚动 */
      padding-left: 2rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
    }
  }

  /* ======================================================================
     头部
     ====================================================================== */
  .back-link {
    display: inline-block;
    color: var(--celadon);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .article-header {
    margin-top: 1.5rem;
  }

  .stage {
    color: var(--seal);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    font-size: var(--fs-h2);
    line-height: 1.06;
    letter-spacing: 0;
    margin: 0.6rem 0 0.9rem;
  }

  .description {
    max-width: 62ch;
    font-size: var(--fs-lede);
    line-height: 1.5;
    color: var(--ink-70);
  }

  /* 页面级核验信息条：发丝线承接 description，等宽小字 + 青瓷圆点，
