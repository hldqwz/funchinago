<script>
  /* 把「整列都是数字」的表格列标记为 data-numeric，交由 CSS 右对齐 + 等宽数字。
     无 JS 时表格仍然完整可读，只是数字左对齐。 */
  (function () {
    const NUMERIC_CELL =
      /^[-+]?[$€£¥]?\s?\d[\d,\s]*(?:\.\d+)?\s?(?:%|km|m|min|mins|minutes|hour|hours|day|days|rmb|cny|usd|yuan|¥)?\.?$/i;

    document.querySelectorAll<HTMLTableElement>('.article-content table').forEach((table) => {
      const rows = Array.from(table.querySelectorAll('tbody tr'));
      if (rows.length === 0) return;

      const columnCount = rows.reduce((max, row) => Math.max(max, row.cells.length), 0);

      for (let column = 0; column < columnCount; column += 1) {
        const cells = rows
          .map((row) => row.cells[column])
          .filter((cell): cell is HTMLTableCellElement => Boolean(cell));
        if (cells.length === 0) continue;

        const numeric = cells.filter((cell) =>
          NUMERIC_CELL.test((cell.textContent || '').trim()),
        ).length;
        if (numeric / cells.length < 0.6) continue;

        cells.forEach((cell) => cell.setAttribute('data-numeric', ''));
        const header = table.querySelector('thead tr');
        if (header && header.cells[column]) {
          header.cells[column].setAttribute('data-numeric', '');
        }
      }
    });
  })();
</script>
