---
import Layout from "../../layouts/ChinaTravelLayout.astro";
import { getCollection } from "astro:content";
import { startHereCards } from "../../data/chinaStarterPortal";

const starterArticles = (await getCollection("chinaTravel"))
  .filter((article) => article.data.section === "start-here")
  .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());
---

<Layout
  title="Start Here"
  description="The easiest way to begin understanding China: plan your trip, choose a city, and get oriented before you go deeper."
>
  <main class="portal-landing">
    <section class="landing-hero">
      <div>
        <p class="eyebrow">Start Here</p>
        <h1>The easiest first steps for understanding China.</h1>
        <p class="lede">
          If this is your first serious look at China, begin with a route, a city fit,
          and a practical sense of what daily life feels like on the ground.
        </p>
        <div class="hero-pills" aria-label="Start here priorities">
          <span>First trip confidence</span>
          <span>City fit before booking</span>
          <span>Official-source guidance</span>
        </div>
      </div>
      <img
        class="hero-image"
        src="/china-travel/images/start-plan-first-trip-editorial.png"
        alt="First-time China trip planning scene with route notes, transport, and city choices"
      />
    </section>

    <section class="path-grid" aria-label="Start here paths">
      {startHereCards.map((card) => (
        <a class="path-card" href={card.href}>
          <img src={card.image} alt={card.alt} />
          <div>
            <span>{card.label}</span>
            <h2>{card.title}</h2>
            <p>{card.text}</p>
          </div>
        </a>
      ))}
    </section>

    <section class="article-strip">
      <div class="section-head">
        <p class="eyebrow">Big-picture guides</p>
        <h2>Read these before you zoom into details.</h2>
        <p class="section-note">Every planning article links back to our official-source library for policy-sensitive details.</p>
      </div>

      <div class="article-grid">
        {starterArticles.map((article) => (
          <a class="article-card" href={`/china-travel/articles/${article.id}/`}>
            {article.data.hero_image && <img src={article.data.hero_image} alt={`Cover image for ${article.data.title}`} loading="lazy" />}
            <div>
              <h3>{article.data.title}</h3>
              <p>{article.data.description}</p>
            </div>
          </a>
        ))}
      </div>

      <a class="source-link" href="/china-travel/sources/">Browse the official source library</a>
    </section>
  </main>
</Layout>

<style>
  .portal-landing {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2.25rem 1.5rem 4rem;
  }

  .landing-hero,
  .article-strip {
    margin-bottom: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .landing-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(280px, 0.96fr);
    gap: 1rem;
    align-items: center;
  }

  .eyebrow {
    margin-bottom: 0.65rem;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 760px;
    font-size: clamp(2.3rem, 6vw, 4.5rem);
    line-height: 0.96;
    letter-spacing: -0.06em;
  }

  .lede {
    max-width: 720px;
    margin-top: 1rem;
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .hero-image {
    width: 100%;
    min-height: 280px;
    border-radius: 22px;
    object-fit: cover;
    background: #eadfd1;
    box-shadow: var(--shadow);
  }

  .hero-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .hero-pills span {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    background: var(--accent-soft);
    border: 1px solid var(--border);
    color: var(--accent-strong);
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .path-grid,
  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .path-card,
  .article-card {
    display: block;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface-strong);
    color: var(--text);
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }

  .path-card:hover,
  .article-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
  }

  .path-card img,
  .article-card img {
    display: block;
    width: 100%;
    height: 210px;
    object-fit: cover;
  }

  .path-card div,
  .article-card div {
    padding: 1rem;
  }

  .path-card span {
    display: inline-flex;
    margin-bottom: 0.4rem;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .path-card h2,
  .section-head h2,
  .article-card h3 {
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .section-note {
    margin-top: 0.5rem;
    color: var(--text-secondary);
    max-width: 640px;
  }

  .path-card h2 {
    margin-bottom: 0.35rem;
    font-size: 1.2rem;
  }

  .article-card h3 {
    margin-bottom: 0.4rem;
    font-size: 1.05rem;
  }

  .path-card p,
  .article-card p {
    color: var(--text-secondary);
  }

  .source-link {
    display: inline-flex;
    margin-top: 1rem;
    font-weight: 850;
    color: var(--accent-strong);
  }

  @media (max-width: 900px) {
    .landing-hero {
      grid-template-columns: 1fr;
    }

    .path-grid,
    .article-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 620px) {
    .portal-landing {
      padding: 1.35rem 1rem 3rem;
    }

    .path-grid,
    .article-grid {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: 2.4rem;
    }
  }
</style>
