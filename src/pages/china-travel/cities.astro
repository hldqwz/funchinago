---
import Layout from "../../layouts/ChinaTravelLayout.astro";
import { getCollection } from "astro:content";
import { cityComparisonCards, featuredCity } from "../../data/chinaStarterPortal";

const articleSlug = (id: string) => id.replace(/\.md$/, "");

const cityArticles = (await getCollection("china-travel"))
  .filter((article) => article.data.section === "cities")
  .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());
---

<Layout
  title="Cities"
  description="Compare first-time-friendly China cities and choose the destination mix that fits your trip style."
>
  <main class="section-page">
    <section class="section-hero">
      <div>
        <p class="eyebrow">Cities</p>
        <h1>Start with the city that fits how you travel.</h1>
        <p class="lede">
          Some visitors want classic sights, some want food, some want a softer landing.
          Use these city snapshots to narrow your first China route.
        </p>
        <div class="hero-pills" aria-label="City comparison lenses">
          <span>History or skyline</span>
          <span>Food or soft landing</span>
          <span>Big energy or easier pace</span>
        </div>
      </div>
      <img
        class="hero-image"
        src="/china-travel/images/start-choose-first-city-editorial.png"
        alt="Editorial China city comparison with skyline, transport, and destination planning mood"
      />
    </section>

    <section class="city-grid" aria-label="City comparisons">
      {cityComparisonCards.map((city) => (
        <a class="city-card" href={city.href}>
          <img src={city.image} alt={`${city.city} travel planning visual`} />
          <div>
            <span>{city.pace}</span>
            <h2>{city.city}</h2>
            <p>{city.bestFor}</p>
          </div>
        </a>
      ))}
    </section>

    <section class="feature-block feature-accent">
      <img class="feature-image" src={featuredCity.image} alt={featuredCity.alt} loading="lazy" />
      <div>
        <p class="eyebrow">Weekly recommendation</p>
        <h2>{featuredCity.title}</h2>
        <p>{featuredCity.text}</p>
        <a class="feature-link" href={featuredCity.href}>{featuredCity.cta}</a>
      </div>
    </section>

    <section class="article-strip">
      <div class="section-head">
        <p class="eyebrow">City guides</p>
        <h2>Go deeper once a city catches your eye.</h2>
      </div>

      <div class="article-grid">
        {cityArticles.map((article) => (
          <a class="article-card" href={`/china-travel/articles/${articleSlug(article.id)}/`}>
            {article.data.hero_image && <img src={article.data.hero_image} alt={`Cover image for ${article.data.title}`} loading="lazy" />}
            <div>
              <h3>{article.data.title}</h3>
              <p>{article.data.description}</p>
            </div>
          </a>
        ))}
      </div>

      <a class="source-link" href="/china-travel/sources/">See the source library for rail, payment, and policy references</a>
    </section>
  </main>
</Layout>

<style>
  .section-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2.25rem 1.5rem 4rem;
  }

  .section-hero,
  .feature-block,
  .article-strip {
    margin-bottom: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .section-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(280px, 0.96fr);
    gap: 1rem;
    align-items: center;
  }

  .eyebrow {
    margin-bottom: 0.65rem;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 780px;
    font-size: clamp(2.3rem, 6vw, 4.4rem);
    line-height: 0.96;
    letter-spacing: 0;
  }

  .lede,
  .feature-block p {
    max-width: 720px;
    margin-top: 1rem;
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .hero-image {
    width: 100%;
    min-height: 280px;
    border-radius: 22px;
    object-fit: cover;
    background: #eadfd1;
    box-shadow: var(--shadow);
  }

  .hero-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .hero-pills span {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    background: var(--accent-soft);
    border: 1px solid var(--border);
    color: var(--accent-strong);
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .city-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .city-card,
  .article-card {
    display: block;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface-strong);
    color: var(--text);
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }

  .city-card:hover,
  .article-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
  }

  .city-card img,
  .article-card img {
    display: block;
    width: 100%;
    height: 220px;
    object-fit: cover;
  }

  .city-card div,
  .article-card div {
    padding: 1rem;
  }

  .city-card span {
    display: inline-flex;
    margin-bottom: 0.4rem;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .city-card h2,
  .section-head h2,
  .article-card h3,
  .feature-block h2 {
    letter-spacing: 0;
    line-height: 1.1;
  }

  .city-card h2 {
    margin-bottom: 0.35rem;
    font-size: 1.18rem;
  }

  .article-card h3 {
    margin-bottom: 0.4rem;
    font-size: 1.05rem;
  }

  .city-card p,
  .article-card p {
    color: var(--text-secondary);
  }

  .feature-link {
    display: inline-flex;
    margin-top: 1rem;
    font-weight: 900;
    color: var(--accent-strong);
  }

  .feature-block {
    display: grid;
    grid-template-columns: minmax(280px, 0.95fr) minmax(0, 1.05fr);
    gap: 1.1rem;
    align-items: center;
  }

  .feature-image {
    width: 100%;
    height: 100%;
    min-height: 260px;
    border-radius: 22px;
    object-fit: cover;
    background: #e9dccb;
    box-shadow: var(--shadow);
  }

  .source-link {
    display: inline-flex;
    margin-top: 1rem;
    font-weight: 850;
    color: var(--accent-strong);
  }

  @media (max-width: 900px) {
    .section-hero,
    .feature-block {
      grid-template-columns: 1fr;
    }

    .article-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 620px) {
    .section-page {
      padding: 1.35rem 1rem 3rem;
    }

    .article-grid {
      grid-template-columns: 1fr;
    }

    .city-grid {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: 2.35rem;
    }
  }
</style>
