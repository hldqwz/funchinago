---
import Layout from "../../layouts/ChinaTravelLayout.astro";
import { getCollection } from "astro:content";
import { formatTravelStage } from "../../data/chinaTravelPresentation";

const articleSlug = (id: string) => id.replace(/\.md$/, "");

const seasonalArticles = (await getCollection("china-travel"))
  .filter((article) => article.data.section === "seasonal")
  .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());
---

<Layout
  title="China's Seasonal Events: A Local Calendar for Visitors"
  description="Plan around China's seasonal events: Canton Fair, Huinantian damp, Spring Festival travel rush, typhoon season and New Year flower markets."
>
  <main class="section-page">
    <section class="section-hero">
      <div>
        <p class="eyebrow">Seasonal</p>
        <h1>Read the local calendar, not just the forecast.</h1>
        <p class="lede">
          Some of the biggest changes to a China trip are not on the usual
          tourist calendar. A trade fair, a humid spell, a migration wave, a
          storm season or a flower street can reshape prices, crowds and plans
          within days. These guides explain what happens and what to do.
        </p>
        <div class="hero-pills" aria-label="Seasonal topics">
          <span>Trade fairs</span>
          <span>Weather</span>
          <span>Festivals</span>
        </div>
      </div>
      <img
        class="hero-image"
        src="/china-travel/images/en-canton-tower-night.webp"
        alt="Canton Tower lit up at night beside the Pearl River in Guangzhou"
      />
    </section>

    <section class="seasonal-list" aria-labelledby="all-seasonal-title">
      <div class="topic-heading">
        <p class="eyebrow">Local knowledge</p>
        <h2 id="all-seasonal-title">The recurring events worth planning around</h2>
        <p class="lede compact">
          Each guide separates verified dates and official rules from the
          practical on-the-ground advice that locals take for granted.
        </p>
      </div>

      <div class="article-grid">
        {seasonalArticles.map((article, index) => (
          <a
            class:list={{ "article-card": true, "primary-card": index === 0 }}
            href={`/china-travel/articles/${articleSlug(article.id)}/`}
          >
            {article.data.hero_image && (
              <img src={article.data.hero_image} alt={`Cover image for ${article.data.title}`} loading="lazy" />
            )}
            <div>
              <span>{formatTravelStage(article.data.stage)}</span>
              <h3>{article.data.title}</h3>
              <p>{article.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="source-callout feature-accent" aria-labelledby="seasonal-sources-title">
      <div>
        <p class="eyebrow">Accuracy first</p>
        <h2 id="seasonal-sources-title">Dates can move. Check the official source before you book.</h2>
        <p class="lede compact">
          Fair schedules, ticket sale windows, warning levels and market locations
          are all published by organisers, railways or weather authorities. Every
          guide links to the primary channels, and we mark figures we could not
          officially verify rather than presenting them as fixed facts.
        </p>
        <a class="source-link" href="/china-travel/sources/">Open the source library</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .section-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2.25rem 1.5rem 4rem;
  }

  .section-hero {
    margin-bottom: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    padding: clamp(1.25rem, 3vw, 2rem);
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(280px, 0.92fr);
    gap: 1rem;
    align-items: center;
  }

  .eyebrow {
    margin-bottom: 0.65rem;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 780px;
    font-size: clamp(2.3rem, 6vw, 4.4rem);
    line-height: 0.96;
    letter-spacing: 0;
  }

  .lede {
    max-width: 720px;
    margin-top: 1rem;
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .hero-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .hero-pills span {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    background: var(--accent-soft);
    border: 1px solid var(--border);
    color: var(--accent-strong);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero-image {
    width: 100%;
    min-height: 260px;
    border-radius: 22px;
    object-fit: cover;
    background: #ecdfcf;
    box-shadow: var(--shadow);
  }

  .compact {
    max-width: 760px;
    margin-top: 0.75rem;
    font-size: 1rem;
  }

  .topic-heading {
    margin-bottom: 1rem;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .article-card {
    display: block;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface-strong);
    color: var(--text);
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }

  .article-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
  }

  .article-card img {
    display: block;
    width: 100%;
    height: 210px;
    object-fit: cover;
  }

  .article-card div {
    padding: 1rem;
  }

  .article-card span {
    display: inline-flex;
    margin-bottom: 0.4rem;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-card h3 {
    margin-bottom: 0.4rem;
    font-size: 1.08rem;
    line-height: 1.15;
    letter-spacing: 0;
  }

  .article-card p {
    color: var(--text-secondary);
  }

  .article-card.primary-card {
    grid-column: span 2;
    display: grid;
    grid-template-columns: minmax(220px, 0.85fr) minmax(0, 1.15fr);
    align-items: stretch;
  }

  .article-card.primary-card img {
    height: 100%;
    min-height: 240px;
  }

  .source-callout {
    margin-top: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .source-link {
    display: inline-flex;
    margin-top: 1rem;
    font-weight: 700;
    color: var(--accent-strong);
  }

  @media (max-width: 900px) {
    .section-hero {
      grid-template-columns: 1fr;
    }

    .article-grid {
      grid-template-columns: 1fr 1fr;
    }

    .article-card.primary-card {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .section-page {
      padding: 1.35rem 1rem 3rem;
    }

    .article-grid {
      grid-template-columns: 1fr;
    }

    .article-card.primary-card {
      display: block;
      grid-column: auto;
    }

    .article-card.primary-card img {
      height: 210px;
      min-height: 0;
    }

    h1 {
      font-size: 2.35rem;
    }
  }
</style>
