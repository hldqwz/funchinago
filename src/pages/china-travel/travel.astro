---
import Layout from "../../layouts/ChinaTravelLayout.astro";
import { getCollection } from "astro:content";
import { formatTravelStage, travelArticleGroups } from "../../data/chinaTravelPresentation";

const articleSlug = (id: string) => id.replace(/\.md$/, "");

const travelArticles = (await getCollection("china-travel"))
  .filter((article) => article.data.section === "travel")
  .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());

const travelArticleBySlug = new Map(
  travelArticles.map((article) => [articleSlug(article.id), article]),
);

const groupedTravelSlugs = new Set(
  travelArticleGroups.flatMap((group) => [...group.slugs]),
);

const groupedTravel = travelArticleGroups.map((group) => ({
  ...group,
  articles: group.slugs
    .map((slug) => travelArticleBySlug.get(slug))
    .filter((article) => article !== undefined),
}));

const ungroupedTravelArticles = travelArticles.filter(
  (article) => !groupedTravelSlugs.has(articleSlug(article.id)),
);
---

<Layout
  title="China Travel Essentials: Payments, Apps, Trains & Entry"
  description="Prepare for a first trip to China with practical guides to payments, essential apps, internet access, entry documents, trains, and route planning."
>
  <main class="section-page">
    <section class="section-hero">
      <div>
        <p class="eyebrow">Travel</p>
        <h1>Handle the trip setup that actually matters.</h1>
        <p class="lede">
          Visas, payments, apps, internet, trains, and route planning decide whether
          your first China trip feels smooth or stressful.
        </p>
        <div class="hero-pills" aria-label="Travel setup priorities">
          <span>Entry rules</span>
          <span>Payment setup</span>
          <span>Apps and trains</span>
        </div>
      </div>
      <img
        class="hero-image"
        src="/china-travel/images/article-checklist-editorial.png"
        alt="China trip planning desk with phone, route notes, and travel checklist"
      />
    </section>

    <div class="travel-topic-list">
      {groupedTravel.map((group) => (
        <section class="travel-topic feature-accent" aria-labelledby={`${group.id}-title`}>
          <div class="topic-heading">
            <p class="eyebrow">Travel essentials</p>
            <h2 id={`${group.id}-title`}>{group.title}</h2>
            <p class="lede compact">{group.description}</p>
          </div>
          <div class="article-grid">
            {group.articles.map((article) => (
              <a
                class:list={{ "article-card": true, "primary-card": articleSlug(article.id) === group.primarySlug }}
                href={`/china-travel/articles/${articleSlug(article.id)}/`}
              >
                {article.data.hero_image && <img src={article.data.hero_image} alt={`Cover image for ${article.data.title}`} loading="lazy" />}
                <div>
                  <span>{formatTravelStage(article.data.stage)}</span>
                  <h3>{article.data.title}</h3>
                  <p>{article.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    {ungroupedTravelArticles.length > 0 && (
      <section class="travel-topic feature-accent" aria-labelledby="unclassified-travel-title">
        <div class="topic-heading">
          <p class="eyebrow">More planning guides</p>
          <h2 id="unclassified-travel-title">Additional travel preparation</h2>
          <p class="lede compact">These guides remain available while their best planning category is reviewed.</p>
        </div>
        <div class="article-grid">
          {ungroupedTravelArticles.map((article) => (
            <a class="article-card" href={`/china-travel/articles/${articleSlug(article.id)}/`}>
              {article.data.hero_image && <img src={article.data.hero_image} alt={`Cover image for ${article.data.title}`} loading="lazy" />}
              <div>
                <span>{formatTravelStage(article.data.stage)}</span>
                <h3>{article.data.title}</h3>
                <p>{article.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="source-callout feature-accent" aria-labelledby="travel-sources-title">
      <div>
        <p class="eyebrow">Accuracy first</p>
        <h2 id="travel-sources-title">Use official sources for visas, payments, trains, and entry rules.</h2>
        <p class="lede compact">
          Our travel planning pieces are written to be readable first, but the underlying facts should come from official Chinese government or platform-authoritative pages.
        </p>
        <a class="source-link" href="/china-travel/sources/">Open the source library</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .section-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2.25rem 1.5rem 4rem;
  }

  .section-hero {
    margin-bottom: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    padding: clamp(1.25rem, 3vw, 2rem);
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(280px, 0.92fr);
    gap: 1rem;
    align-items: center;
  }

  .eyebrow {
    margin-bottom: 0.65rem;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 780px;
    font-size: clamp(2.3rem, 6vw, 4.4rem);
    line-height: 0.96;
    letter-spacing: 0;
  }

  .lede {
    max-width: 720px;
    margin-top: 1rem;
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .hero-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .hero-pills span {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    background: var(--accent-soft);
    border: 1px solid var(--border);
    color: var(--accent-strong);
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero-image {
    width: 100%;
    min-height: 260px;
    border-radius: 22px;
    object-fit: cover;
    background: #ecdfcf;
    box-shadow: var(--shadow);
  }

  .compact {
    max-width: 760px;
    margin-top: 0.75rem;
    font-size: 1rem;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .travel-topic-list {
    display: grid;
    gap: 1.25rem;
  }

  .travel-topic {
    padding: clamp(1.2rem, 3vw, 1.8rem);
  }

  .topic-heading {
    margin-bottom: 1rem;
  }

  .article-card {
    display: block;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface-strong);
    color: var(--text);
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }

  .article-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
  }

  .article-card img {
    display: block;
    width: 100%;
    height: 210px;
    object-fit: cover;
  }

  .article-card div {
    padding: 1rem;
  }

  .article-card span {
    display: inline-flex;
    margin-bottom: 0.4rem;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-card h3 {
    margin-bottom: 0.4rem;
    font-size: 1.08rem;
    line-height: 1.15;
    letter-spacing: 0;
  }

  .article-card p {
    color: var(--text-secondary);
  }

  .article-card.primary-card {
    grid-column: span 2;
    display: grid;
    grid-template-columns: minmax(220px, 0.85fr) minmax(0, 1.15fr);
    align-items: stretch;
  }

  .article-card.primary-card img {
    height: 100%;
    min-height: 240px;
  }

  .source-callout {
    margin-top: 1.25rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .source-link {
    display: inline-flex;
    margin-top: 1rem;
    font-weight: 850;
    color: var(--accent-strong);
  }

  @media (max-width: 900px) {
    .section-hero {
      grid-template-columns: 1fr;
    }

    .article-grid {
      grid-template-columns: 1fr 1fr;
    }

    .article-card.primary-card {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .section-page {
      padding: 1.35rem 1rem 3rem;
    }

    .article-grid {
      grid-template-columns: 1fr;
    }

    .article-card.primary-card {
      display: block;
      grid-column: auto;
    }

    .article-card.primary-card img {
      height: 210px;
      min-height: 0;
    }

    h1 {
      font-size: 2.35rem;
    }
  }
</style>
