---
// src/pages/index.astro — 排行榜首页（Vellum 风格 + 三平台）
import Layout from "../layouts/Layout.astro";
import { useTranslations, detectLocale } from "../i18n";
import type { ModelData } from "../types";

const locale = detectLocale(Astro.url.pathname);
const t = useTranslations(locale);

let models: ModelData[] = [];
let updatedAt = "";
let platformStats = { openrouter: 0, groq: 0, siliconflow: 0, bailian: 0, multi_platform: 0 };

try {
  const raw = await import("../data/models.json");
  if (raw.default && raw.default.models) {
    models = raw.default.models;
    updatedAt = raw.default.updated_at || "";
    platformStats = raw.default.platform_stats || platformStats;
  }
} catch {}

// ── Helper: 获取模型在各平台的价格（统一为 每百万token 美元） ──
function priceOR(model: ModelData, side: "prompt" | "completion"): number {
  const p = model.platforms?.openrouter?.pricing;
  if (!p) return -1;
  return parseFloat(p[side] || "0") * 1_000_000;
}
function priceGR(model: ModelData, side: "prompt" | "completion"): number {
  const p = model.platforms?.groq?.pricing;
  if (!p) return -1;
  if (side === "prompt") return p.prompt_per_m ?? parseFloat(p.prompt || "0");
  return p.completion_per_m ?? parseFloat(p.completion || "0");
}
function priceSF(model: ModelData, side: "prompt" | "completion"): number {
  const p = model.platforms?.siliconflow?.pricing;
  if (!p) return -1;
  if (side === "prompt") return p.prompt_per_m ?? (parseFloat(p.prompt || "0") * 1_000_000);
  return p.completion_per_m ?? (parseFloat(p.completion || "0") * 1_000_000);
}

function getRoundtrip(model: ModelData): number | null {
  const in_ = priceOR(model, "prompt");
  const out_ = priceOR(model, "completion");
  if (in_ < 0 || out_ < 0) return null;
  return in_ + out_;
}

// ── 获取模型在至少一个平台上有价格的输入/输出价 ──
function getMinInputPrice(model: ModelData): number | null {
  const prices = [priceOR(model, "prompt"), priceGR(model, "prompt"), priceSF(model, "prompt")]
    .filter(p => p >= 0);
  return prices.length > 0 ? Math.min(...prices) : null;
}
function getMinOutputPrice(model: ModelData): number | null {
  const prices = [priceOR(model, "completion"), priceGR(model, "completion"), priceSF(model, "completion")]
    .filter(p => p >= 0);
  return prices.length > 0 ? Math.min(...prices) : null;
}

// ── 获取模型可用的平台列表 ──
function getPlatforms(model: ModelData): string[] {
  return Object.keys(model.platforms || {});
}

// ── Usage / Trend ──
function getUsage(model: ModelData): number | null {
  return model.platforms?.openrouter?.usage_tokens ?? null;
}
function getTrend(model: ModelData): string {
  return model.platforms?.openrouter?.trend || "";
}
function getRank(model: ModelData): number | null {
  return model.platforms?.openrouter?.rank ?? null;
}
function usageDisplay(n: number | null): string {
  if (!n) return "—";
  if (n >= 1e12) return (n / 1e12).toFixed(1) + "T";
  if (n >= 1e9) return (n / 1e9).toFixed(1) + "B";
  if (n >= 1e6) return (n / 1e6).toFixed(1) + "M";
  if (n >= 1e3) return (n / 1e3).toFixed(0) + "K";
  return n.toString();
}
function contextK(model: ModelData): number {
  // 取任意平台有值的上下文
  const ctx = model.platforms?.openrouter?.context_length
    || model.platforms?.groq?.context_length
    || model.platforms?.siliconflow?.context_length || model.platforms?.bailian?.context_length
    || 0;
  return Math.round(ctx / 1024);
}

// ── 排名模型列表 ──
const rankedModels = models
  .filter(m => getPlatforms(m).includes("openrouter") && getRank(m))
  .sort((a, b) => (getRank(a) || 999) - (getRank(b) || 999));

const unrankedModels = models.filter(m => !getRank(m));

// ── Top N 分类 ──
const topMostUsed = [...rankedModels]
  .sort((a, b) => (getUsage(b) || 0) - (getUsage(a) || 0))
  .slice(0, 5);

const topValue = [...rankedModels]
  .filter(m => getRoundtrip(m) !== null)
  .sort((a, b) => (getRoundtrip(a) || Infinity) - (getRoundtrip(b) || Infinity))
  .slice(0, 5);

const topTrending = [...rankedModels]
  .filter(m => {
    const t = getTrend(m);
    const num = parseFloat(t.replace(/[^0-9.\-]/g, ""));
    return !isNaN(num) && num > 0;
  })
  .sort((a, b) => {
    const ta = parseFloat(getTrend(a).replace(/[^0-9.\-]/g, "0"));
    const tb = parseFloat(getTrend(b).replace(/[^0-9.\-]/g, "0"));
    return tb - ta;
  })
  .slice(0, 5);

const topCtx = [...models]
  .filter(m => contextK(m) > 0)
  .sort((a, b) => contextK(b) - contextK(a))
  .slice(0, 5);

// ── Max values for bar ──
const maxUsage = topMostUsed.length > 0 ? getUsage(topMostUsed[0]) || 1 : 1;
const maxTrend = topTrending.length > 0
  ? parseFloat(getTrend(topTrending[0]).replace(/[^0-9.\-]/g, "0")) || 1
  : 1;
const maxCtx = topCtx.length > 0 ? contextK(topCtx[0]) || 1 : 1;

// ── 平台标签 ──
function platformBadge(platform: string): string {
  return platform === "openrouter" ? "OR"
    : platform === "groq" ? "GR"
    : "SF";
}
function platformColor(platform: string): string {
  return platform === "openrouter" ? "badge-blue"
    : platform === "groq" ? "badge-purple"
    : "badge-orange";
}

// ── Rank medal ──
function rankClass(r: number | null): string {
  if (r === 1) return "gold";
  if (r === 2) return "silver";
  if (r === 3) return "bronze";
  return "";
}

// ── Modality ──
function getModality(model: ModelData): { type: string; icon: string } {
  const arch = model.platforms?.openrouter?.architecture;
  const mod = arch?.modality || "";
  if (!mod || mod === "text->text") return { type: "text", icon: "" };
  const [input, output] = mod.split("->");
  const inputs = (input || "").split("+");
  const outputs = (output || "").split("+");
  const hasImageIn = inputs.includes("image");
  const hasVideoIn = inputs.includes("video");
  const hasAudioIn = inputs.includes("audio");
  const hasFileIn = inputs.includes("file");
  const hasImageOut = outputs.includes("image");
  if (hasImageOut) return { type: "img_gen", icon: "🎨" };
  if (hasVideoIn) return { type: "video", icon: "🎬" };
  if (hasImageIn || hasFileIn) return { type: "vision", icon: "👁️" };
  return { type: "multimodal", icon: "👁️" };
}
---

<Layout title={t("site.title")} description={t("site.description")} lang={locale}>
  <!-- Hero -->
  <div class="container" style="padding-top: 2rem;">
    <div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.75rem;">
      <div>
        <h1 style="font-size: 1.65rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1.25;">
          {t("home.hero_title")}
        </h1>
        <p style="color: var(--text-secondary); margin-top: 0.3rem; font-size: 0.9rem;">
          {t("home.hero_subtitle")}
          {updatedAt && <> · {t("site.updated")} <time class="relative-time" datetime={updatedAt}>{new Date(updatedAt).toLocaleString(locale === "zh" ? "zh-CN" : "en-US", { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" })}</time></>}
        </p>
      </div>
      <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
        <span class="badge badge-blue">🏆 {platformStats.openrouter} {t("home.stat_ranked")}</span>
        <span class="badge badge-purple">{t("home.stat_collected")} {models.length}</span>
      </div>
    </div>

    <!-- Stat tiles -->
    <div class="stat-grid" style="margin-bottom: 2rem;">
      <div class="stat-tile">
        <div class="stat-value" style="color: var(--accent);">{models.length}</div>
        <div class="stat-label">{t("home.stat_collected")}</div>
      </div>
      <div class="stat-tile">
        <div class="stat-value" style="color: var(--green);">{rankedModels.length}</div>
        <div class="stat-label">{t("home.stat_ranked")}</div>
      </div>
      <div class="stat-tile">
        <div class="stat-value" style="color: var(--accent-2);">
          {[platformStats.openrouter > 0, platformStats.groq > 0, platformStats.siliconflow > 0, platformStats.bailian > 0].filter(Boolean).length}
        </div>
        <div class="stat-label">{t("home.stat_platforms")}</div>
      </div>
      <div class="stat-tile">
        <div class="stat-value" style="color: var(--gold); font-size: 1.3rem;">
          {topCtx.length > 0 ? `${contextK(topCtx[0]).toLocaleString()}K` : "—"}
        </div>
        <div class="stat-label">{t("home.stat_context")}</div>
      </div>
    </div>

    <!-- Top 排行榜：Vellum 风格宽卡片 -->
    <h2 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
      <span>🏆</span> Top Rankings
      <span style="font-size: 0.75rem; font-weight: 400; color: var(--text-tertiary);">· {t("home.stat_ranked").toLowerCase()}</span>
    </h2>

    <div class="leader-grid">
      <!-- Most Used -->
      <div class="leader-card">
        <h3>📊 {t("home.section_most_used")}</h3>
        {topMostUsed.length > 0 && topMostUsed.map((m, i) => {
          const usage = getUsage(m);
          const pct = usage ? Math.max(3, (usage / Number(maxUsage)) * 100) : 3;
          return (
            <div class="leader-row">
              <span class="leader-num">{i + 1}</span>
              <a href={`/${locale === "zh" ? "zh/" : ""}models/${m.canonical_name}`} class="leader-name">{m.name}</a>
              <div class="leader-bar">
                <div class="bar-fill bar-blue" style={`width: ${pct}%`}></div>
              </div>
              <span class="leader-score">{usageDisplay(usage)}</span>
            </div>
          );
        })}
        {topMostUsed.length === 0 && <div class="empty-state">{t("home.empty_most_used")}</div>}
      </div>

      <!-- Best Value -->
      <div class="leader-card">
        <h3>💰 {t("home.section_best_value")}</h3>
        {topValue.length > 0 && topValue.map((m, i) => {
          const p = getRoundtrip(m) || 0;
          const maxP = getRoundtrip(topValue[topValue.length - 1]) || 1;
          const pct = Math.max(3, (1 - p / maxP) * 100);
          return (
            <div class="leader-row">
              <span class="leader-num">{i + 1}</span>
              <a href={`/${locale === "zh" ? "zh/" : ""}models/${m.canonical_name}`} class="leader-name">{m.name}</a>
              <div class="leader-bar">
                <div class="bar-fill bar-green" style={`width: ${pct}%`}></div>
              </div>
              <span class="leader-score">${p.toFixed(2)}</span>
            </div>
          );
        })}
        {topValue.length === 0 && <div class="empty-state">{t("home.empty_best_value")}</div>}
      </div>

      <!-- Trending -->
      <div class="leader-card">
        <h3>🔥 {t("home.section_trending")}</h3>
        {topTrending.length > 0 && topTrending.map((m, i) => {
          const tr = getTrend(m);
          const num = parseFloat(tr.replace(/[^0-9.\-]/g, "0"));
          const pct = Math.max(3, (num / maxTrend) * 100);
          return (
            <div class="leader-row">
              <span class="leader-num">{i + 1}</span>
              <a href={`/${locale === "zh" ? "zh/" : ""}models/${m.canonical_name}`} class="leader-name">{m.name}</a>
              <div class="leader-bar">
                <div class="bar-fill bar-gold" style={`width: ${pct}%`}></div>
              </div>
              <span class="leader-score">↑{tr}</span>
            </div>
          );
        })}
        {topTrending.length === 0 && <div class="empty-state">{t("home.empty_trending")}</div>}
      </div>

      <!-- Longest Context -->
      <div class="leader-card">
        <h3>📐 {t("home.section_longest_context")}</h3>
        {topCtx.length > 0 && topCtx.map((m, i) => {
          const ctx = contextK(m);
          const pct = Math.max(3, (ctx / maxCtx) * 100);
          return (
            <div class="leader-row">
              <span class="leader-num">{i + 1}</span>
              <a href={`/${locale === "zh" ? "zh/" : ""}models/${m.canonical_name}`} class="leader-name">{m.name}</a>
              <div class="leader-bar">
                <div class="bar-fill bar-purple" style={`width: ${pct}%`}></div>
              </div>
              <span class="leader-score">{ctx.toLocaleString()}K</span>
            </div>
          );
        })}
        {topCtx.length === 0 && <div class="empty-state">{t("home.empty_context")}</div>}
      </div>
    </div>

    <!-- Search + Filter -->
    <div class="search-wrap" style="margin-bottom: 0.75rem;">
      <span class="search-icon">🔍</span>
      <input id="model-search" class="search-input" type="text" placeholder={t("home.search_placeholder")} />
    </div>
    <div class="filter-bar" style="display: flex; gap: 0.4rem; margin-bottom: 1rem; align-items: center; flex-wrap: wrap;">
      <span style="font-size: 0.75rem; color: var(--text-tertiary); margin-right: 0.25rem;">{t("home.sort_tip")}</span>
      <button class="filter-btn active" data-filter="all">{t("home.filter_all")}</button>
      <button class="filter-btn" data-filter="openrouter">{t("home.filter_or")}</button>
      <button class="filter-btn" data-filter="groq">{t("home.filter_tj")}</button>
      <button class="filter-btn" data-filter="siliconflow">{t("home.filter_sf")}</button>
      <button class="filter-btn" data-filter="bailian">{t("home.filter_bl")}</button>
    </div>
    <div class="filter-bar" style="display: flex; gap: 0.4rem; margin-bottom: 1rem; align-items: center; flex-wrap: wrap;">
      <span style="font-size: 0.75rem; color: var(--text-tertiary); margin-right: 0.25rem;">Type:</span>
      <button class="filter-btn modality-btn active" data-modality="all">{t("home.filter_all")}</button>
      <button class="filter-btn modality-btn" data-modality="multimodal">{t("home.filter_multimodal")}</button>
      <button class="filter-btn modality-btn" data-modality="vision">{t("home.filter_vision")}</button>
      <button class="filter-btn modality-btn" data-modality="img_gen">{t("home.filter_image_gen")}</button>
    </div>

    <!-- Main Table -->
    <div class="card table-wrap">
      <table>
        <thead>
          <tr>
            <th style="width: 40px; text-align: center;">{t("home.col_rank")}</th>
            <th class="sortable" data-sort="name">{t("home.col_model")} <span class="sort-arrow"></span></th>
            <th class="sortable" data-sort="input" style="text-align: right;">{t("home.col_input")} <span class="sort-arrow"></span></th>
            <th class="sortable" data-sort="output" style="text-align: right;">{t("home.col_output")} <span class="sort-arrow"></span></th>
            <th style="text-align: center;">{t("home.col_platforms")}</th>
            <th class="sortable" data-sort="context" style="text-align: right;">{t("home.col_context")} <span class="sort-arrow"></span></th>
            <th class="sortable default-sort" data-sort="usage" style="text-align: right;">{t("home.col_usage")} <span class="sort-arrow"></span></th>
            <th class="sortable" data-sort="trend" style="text-align: center;">{t("home.col_trend")} <span class="sort-arrow"></span></th>
          </tr>
        </thead>
        <tbody>
          {rankedModels.map((model) => {
            const r = getRank(model) || 0;
            const inPrice = getMinInputPrice(model);
            const outPrice = getMinOutputPrice(model);
            const platforms = getPlatforms(model);
            const ctx = contextK(model);
            const usage = getUsage(model);
            const trend = getTrend(model);

            const md = getModality(model);
            return (
              <tr class="model-row" data-name={model.name} data-platforms={getPlatforms(model).join(",")}
	                  data-modality={md.type}
	                  data-input={inPrice !== null ? inPrice : 999999}
	                  data-output={outPrice !== null ? outPrice : 999999}
	                  data-context={ctx}
	                  data-usage={usage || 0}
	                  data-trend={parseFloat(trend.replace(/[^0-9.\-]/g, "0")) || 0}>
                <td style="text-align: center;">
                  <span class={"rank-num " + rankClass(r)}>{r}</span>
                </td>
                <td>
                  <a href={`/${locale === "zh" ? "zh/" : ""}models/${model.canonical_name}`}
                     style="font-weight: 600; color: var(--text);">
                    {model.name}
                  </a>
                  {md.icon && <span style="margin-left: 0.3rem;" title={md.type}>{md.icon}</span>}
                  {model.platforms?.openrouter?.top_provider?.name && (
                    <span class="badge badge-blue badge-platform" style="margin-left: 0.4rem;">
                      {model.platforms.openrouter.top_provider.name}
                    </span>
                  )}
                </td>
                <td style="text-align: right; font-weight: 600;">
                  {inPrice !== null
                    ? <span class="price-value" style={`color: ${inPrice < 1 ? "var(--green)" : "var(--text)"}`}>${inPrice.toFixed(2)}</span>
                    : <span style="color: var(--text-tertiary);">—</span>
                  }
                </td>
                <td style="text-align: right; font-weight: 600;">
                  {outPrice !== null
                    ? <span class="price-value" style={`color: ${outPrice < 2 ? "var(--green)" : "var(--text)"}`}>${outPrice.toFixed(2)}</span>
                    : <span style="color: var(--text-tertiary);">—</span>
                  }
                </td>
                <td style="text-align: center;">
                  <div style="display: flex; gap: 0.2rem; justify-content: center;">
                    {platforms.map(p => (
                      <span class={"badge badge-platform " + platformColor(p)}
                            title={p === "openrouter" ? "OpenRouter" : p === "groq" ? "Groq" : p === "bailian" ? "Bailian" : "SiliconFlow"}>
                        {platformBadge(p)}
                      </span>
                    ))}
                  </div>
                </td>
                <td style="text-align: right; color: var(--text-secondary); font-size: 0.82rem;">
                  {ctx > 0 ? `${ctx.toLocaleString()}K` : "—"}
                </td>
                <td style="text-align: right; font-weight: 600; font-variant-numeric: tabular-nums;">
                  {usageDisplay(usage)}
                </td>
                <td style="text-align: center;">
                  {trend && trend !== "0%" ? (
                    <span class={`badge ${trend.startsWith("-") ? "badge-red" : "badge-green"}`}>
                      {trend.startsWith("-") ? "↓" : "↑"} {trend}
                    </span>
                  ) : (
                    <span style="color: var(--text-tertiary); font-size: 0.75rem;">—</span>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    <!-- Unranked -->
    {unrankedModels.length > 0 && (
      <details style="margin-top: 1.5rem;">
        <summary style="cursor: pointer; color: var(--text-secondary); font-size: 0.85rem; padding: 0.5rem 0;">
          {unrankedModels.length} {t("home.unranked_title")}
        </summary>
        <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.5rem;">
          {unrankedModels.slice(0, 60).map((m) => (
            <a href={`/${locale === "zh" ? "zh/" : ""}models/${m.canonical_name}`} class="badge badge-blue">
              {m.name}
            </a>
          ))}
          {unrankedModels.length > 60 && (
            <span style="color: var(--text-tertiary); font-size: 0.8rem; padding: 0.2rem 0.5rem;">
              {t("home.unranked_count").replace("{count}", unrankedModels.length - 60)}
            </span>
          )}
        </div>
      </details>
    )}
  </div>
</Layout>

<style>
  th.sortable {
    cursor: pointer;
    user-select: none;
    transition: color 0.15s;
  }
  th.sortable:hover {
    color: var(--accent);
  }
  .sort-arrow {
    font-size: 0.6rem;
    margin-left: 0.15rem;
    opacity: 0;
    transition: opacity 0.15s;
  }
  th.sortable:hover .sort-arrow,
  .sort-arrow.asc,
  .sort-arrow.desc {
    opacity: 1;
  }
  .sort-arrow.asc::after {
    content: " ▲";
    color: var(--accent);
  }
  .sort-arrow.desc::after {
    content: " ▼";
    color: var(--accent);
  }
  .empty-state {
    text-align: center;
    padding: 1.5rem 0.5rem;
    color: var(--text-tertiary);
    font-size: 0.82rem;
  }
  .filter-btn {
    padding: 0.35rem 0.85rem;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 500;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s;
  }
  .filter-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .filter-btn.active {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
  }

  .leader-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 640px) {
    .leader-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function() {
    // ── 排序 + 筛选 + 搜索 ──
    const tbody = document.querySelector(".table-wrap table tbody");
    if (!tbody) return;

    let sortKey = "usage";
    let sortDir = -1;
    let activeFilter = "all";
    let activeModality = "all";
    let searchQuery = "";

    function getVal(tr, key) {
      return parseFloat(tr.getAttribute("data-" + key)) || 0;
    }

    function rowVisible(tr) {
      const platforms = tr.getAttribute("data-platforms") || "";
      const modality = tr.getAttribute("data-modality") || "text";
      const name = (tr.getAttribute("data-name") || "").toLowerCase();
      const passFilter = activeFilter === "all" || platforms.split(",").includes(activeFilter);
      const passModality = activeModality === "all" || activeModality === "multimodal" ? modality !== "text" :
                           modality === activeModality;
      const passSearch = !searchQuery || name.includes(searchQuery);
      return passFilter && passModality && passSearch;
    }

    function reorder() {
      const allRows = [...tbody.querySelectorAll(".model-row")];
      // Separate visible vs hidden
      allRows.forEach(tr => {
        tr.style.display = rowVisible(tr) ? "" : "none";
      });
      const visible = allRows.filter(r => r.style.display !== "none");
      const hidden = allRows.filter(r => r.style.display === "none");

      visible.sort((a, b) => {
        if (sortKey === "name") {
          const va = (a.getAttribute("data-name") || "").toLowerCase();
          const vb = (b.getAttribute("data-name") || "").toLowerCase();
          return sortDir * va.localeCompare(vb);
        }
        return sortDir * (getVal(a, sortKey) - getVal(b, sortKey));
      });

      visible.forEach(r => tbody.appendChild(r));
      hidden.forEach(r => tbody.appendChild(r));

      document.querySelectorAll(".sort-arrow").forEach(s => s.classList.remove("asc", "desc"));
      const arrow = document.querySelector(`th[data-sort="${sortKey}"] .sort-arrow`);
      if (arrow) arrow.classList.add(sortDir === 1 ? "asc" : "desc");
    }

    // ── Sort handlers ──
    document.querySelectorAll("th.sortable").forEach(th => {
      th.addEventListener("click", () => {
        const key = th.getAttribute("data-sort");
        sortDir = key === sortKey ? sortDir * -1 : (key === "name" ? 1 : -1);
        sortKey = key;
        reorder();
      });
    });

    // ── Search handler ──
    const searchInput = document.getElementById("model-search");
    if (searchInput) {
      searchInput.addEventListener("input", () => {
        searchQuery = searchInput.value.toLowerCase();
        reorder();
      });
    }

    // ── Filter handlers ──
    document.querySelectorAll(".filter-btn[data-filter]").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".filter-btn[data-filter]").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        activeFilter = btn.getAttribute("data-filter");
        reorder();
      });
    });
    // ── Modality filter handlers ──
    document.querySelectorAll(".modality-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".modality-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        activeModality = btn.getAttribute("data-modality");
        reorder();
      });
    });

    reorder();
  })();

  // ── 相对时间 ──
  (function() {
    function update() {
      const locale = document.documentElement.lang || "en";
      const rtf = new Intl.RelativeTimeFormat(locale, { numeric: "auto", style: "short" });
      document.querySelectorAll("time.relative-time").forEach(el => {
        const diff = (new Date(el.getAttribute("datetime")) - new Date()) / 1000;
        const units = [
          [31536000, "year"], [2592000, "month"], [86400, "day"],
          [3600, "hour"], [60, "minute"], [1, "second"]
        ];
        for (const [sec, unit] of units) {
          if (Math.abs(diff) >= sec || unit === "second") {
            el.textContent = rtf.format(Math.round(diff / sec), unit);
            break;
          }
        }
      });
    }
    update();
    setInterval(update, 60000);
  })();
</script>
