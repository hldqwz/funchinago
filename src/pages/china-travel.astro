---
import Layout from "../layouts/ChinaTravelLayout.astro";
import {
  cityComparisonCards,
  citySpotlightCards,
  heroCarousel,
  featuredCity,
  homepageTools,
  lifeCultureDoorways,
  paymentGuideLinks,
  paymentQuickLinks,
  startHereCards,
} from "../data/chinaStarterPortal";
---

<Layout
  title="China Travel Guide for First-Time Visitors (2026)"
  description="Plan a first China trip with practical guides to payments, apps, trains, cities, entry rules, internet access, and preparation for international visitors."
  ogImage="/china-travel/images/og-shanghai-bund-night.jpg"
>
  <main class="portal-page">
    <section class="portal-hero" data-portal-section="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="portal-kicker">China Travel Made Easy</p>
        <h1 id="hero-title">China, easier than it looks.</h1>
        <p class="hero-lede">
          Pick a city, sort the essentials, and understand how modern China works before you land.
        </p>
        <div class="hero-actions" aria-label="Primary homepage actions">
          <a class="hero-cta" href="#start-here">Start here</a>
          <a class="hero-textlink" href="#cities">Compare cities →</a>
        </div>
        <p class="hero-verified mono-meta verified-dot">
          VERIFIED · 17 OCT 2026 · 31 GUIDES · 24 SOURCES
        </p>
      </div>

      <figure class="hero-visual hero-carousel" data-carousel aria-label="China travel photo carousel">
        <div class="carousel-track">
          {heroCarousel.map((slide, index) => (
            <img
              class={index === 0 ? "is-active" : ""}
              src={slide.image}
              alt={slide.alt}
              width="1100"
              height="1023"
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : undefined}
              decoding="async"
            />
          ))}
        </div>
        <figcaption class="mono-meta carousel-bar">
          <span class="carousel-label" data-carousel-caption aria-live="polite">{heroCarousel[0].label}</span>
          <span class="carousel-dots">
            {heroCarousel.map((slide, index) => (
              <button
                type="button"
                class={index === 0 ? "is-active" : ""}
                data-carousel-dot={index}
                aria-label={`Show ${slide.label}`}
                aria-pressed={index === 0}
              ></button>
            ))}
          </span>
        </figcaption>
      </figure>
      <p class="hero-hint mono-meta">Most visitors need: city choice + payment setup + train confidence</p>
    </section>

    <section id="payment-guides" class="portal-section payment-section reveal" aria-labelledby="payment-guides-title">
      <div class="section-heading">
        <p class="portal-kicker">Payment Guides</p>
        <div class="section-heading-copy">
          <h2 id="payment-guides-title">Solve China payment before the rest of the trip.</h2>
          <p>Start with the hub, then use the app, wallet, and troubleshooting guides when your situation gets specific.</p>
        </div>
      </div>

      <ul class="payment-quick-row" role="list">
        {paymentQuickLinks.map((item) => (
          <li>
            <a class="payment-quick" href={item.href}>
              <span class="payment-chip">
                <span class="payment-chip-eyebrow">{item.eyebrow}</span>
                <strong>{item.title}</strong>
              </span>
              <span class="payment-quick-text">{item.text}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="payment-guides-grid">
        {paymentGuideLinks.map((guide) => (
          <a class="payment-guide-card" href={guide.href}>
            <h3>{guide.title}</h3>
            <p>{guide.text}</p>
          </a>
        ))}
      </div>

      <div class="section-foot-links mono-meta">
        <a href="/china-travel/articles/">Browse all guides</a>
        <a href="/china-travel/sources/">Open source library</a>
      </div>
    </section>

    <section id="start-here" class="portal-section start-section reveal" aria-labelledby="start-title">
      <div class="section-heading">
        <p class="portal-kicker">Start here</p>
        <div class="section-heading-copy">
          <h2 id="start-title">Three doors into your first China trip.</h2>
        </div>
      </div>

      <div class="start-grid">
        {startHereCards.map((card) => (
          <a class="start-card" href={card.href}>
            <img src={card.image} alt={card.alt} loading="lazy" />
            <div class="start-card-copy">
              <span>{card.label}</span>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="cities" class="portal-section cities-section reveal" aria-labelledby="cities-title">
      <div class="section-heading">
        <p class="portal-kicker">Cities</p>
        <div class="section-heading-copy">
          <h2 id="cities-title">Pick the city that matches your first trip.</h2>
          <p>Use these quick snapshots first, then go deeper with city guides and tools.</p>
        </div>
      </div>

      <div class="city-grid">
        {cityComparisonCards.map((city) => (
          <a class="city-card" href={city.href}>
            <img src={city.image} alt={`${city.city} travel planning visual`} loading="lazy" />
            <div class="city-card-copy">
              <span>{city.pace}</span>
              <h3>{city.city}</h3>
              <p>{city.bestFor}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="section-cta-strip">
        <span>Still unsure?</span>
        <a href="/tools/china-city-picker/">Use the city picker</a>
      </div>
    </section>

    <section id="life-culture" class="portal-section culture-section reveal" aria-labelledby="culture-title">
      <div class="section-heading">
        <p class="portal-kicker">Life &amp; Culture</p>
        <div class="section-heading-copy">
          <h2 id="culture-title">Feel prepared for daily China, not just landmarks.</h2>
        </div>
      </div>

      <div class="culture-grid">
        {lifeCultureDoorways.map((doorway) => (
          <a class="culture-card" href={doorway.href}>
            <img src={doorway.image} alt={`${doorway.theme} doorway for China travel`} loading="lazy" />
            <div class="culture-card-copy">
              <span>{doorway.theme}</span>
              <h3>{doorway.title}</h3>
              <p>{doorway.text}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="tools" class="portal-section tools-section reveal" aria-labelledby="tools-title">
      <div class="tools-intro">
        <p class="portal-kicker">Tools</p>
        <h2 id="tools-title">Helpful when you are ready to act.</h2>
        <p>Use the helpers once the big choices are already clear.</p>
      </div>

      <div class="tool-grid">
        {homepageTools.map((tool) => (
          <a class="tool-card" href={tool.href}>
            <img src={tool.image} alt={`${tool.title} tool preview`} loading="lazy" />
            <div class="tool-card-copy">
              <h3>{tool.title}</h3>
              <p>{tool.text}</p>
              <span>{tool.label}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="featured-city" class="city-spotlight reveal" aria-labelledby="featured-title">
      <div class="spotlight-head">
        <div>
          <p class="portal-kicker">City spotlight</p>
          <h2 id="featured-title">Start with one city</h2>
        </div>
        <div class="spotlight-controls">
          <p class="spotlight-hint">Swipe to compare {citySpotlightCards.length + 1} first-time city guides</p>
          <div class="slider-nav">
            <button
              type="button"
              class="slider-arrow"
              data-slider-prev
              aria-label="Scroll to previous city cards"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 5l-7 7 7 7" />
              </svg>
            </button>
            <button
              type="button"
              class="slider-arrow"
              data-slider-next
              aria-label="Scroll to next city cards"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <ul class="city-slider" role="list" data-city-slider>
        <li class="city-slide city-slide-featured">
          <a href={featuredCity.href}>
            <img src={featuredCity.image} alt={featuredCity.alt} />
            <div class="city-slide-copy">
              <span class="city-slide-tag">{featuredCity.eyebrow}</span>
              <h3>{featuredCity.city}</h3>
              <p>{featuredCity.text}</p>
              <span class="city-slide-cta">{featuredCity.cta}</span>
            </div>
          </a>
        </li>
        {citySpotlightCards.map((card) => (
          <li class="city-slide">
            <a href={card.href}>
              <img src={card.image} alt={card.alt} loading="lazy" />
              <div class="city-slide-copy">
                <span class="city-slide-tag">{card.pace}</span>
                <h3>{card.city}</h3>
                <p>{card.text}</p>
                <span class="city-slide-cta">Read the {card.city} guide</span>
              </div>
            </a>
          </li>
        ))}
        <li class="city-slide city-slide-end">
          <a href="/china-travel/cities/">
            <div class="city-slide-copy">
              <span class="city-slide-tag mono-meta">End of list</span>
              <h3>Every city guide</h3>
              <p>That is the full first-time shortlist. See the rest of the city library from here.</p>
              <span class="city-slide-cta">Open the city index →</span>
            </div>
          </a>
        </li>
      </ul>
    </section>
  </main>
</Layout>

<script>
  const sliders = document.querySelectorAll<HTMLElement>("[data-city-slider]");

  sliders.forEach((slider) => {
    const scope = slider.closest("section");
    const prev = scope?.querySelector<HTMLButtonElement>("[data-slider-prev]");
    const next = scope?.querySelector<HTMLButtonElement>("[data-slider-next]");

    const stepSize = () => {
      const card = slider.querySelector<HTMLElement>(".city-slide");
      if (!card) return slider.clientWidth * 0.8;
      const gap = parseFloat(getComputedStyle(slider).columnGap || "16") || 16;
      return card.getBoundingClientRect().width + gap;
    };

    const sync = () => {
      const max = slider.scrollWidth - slider.clientWidth;
      if (prev) prev.disabled = slider.scrollLeft <= 1;
      if (next) next.disabled = slider.scrollLeft >= max - 1;
    };

    prev?.addEventListener("click", () => {
      slider.scrollBy({ left: -stepSize(), behavior: "smooth" });
    });
    next?.addEventListener("click", () => {
      slider.scrollBy({ left: stepSize(), behavior: "smooth" });
    });

    slider.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync);
    sync();
  });

  // Fallback for .reveal entrance animation in case no IntersectionObserver is
  // registered elsewhere on the page. Safe to drop once the layout owns it.
  const revealed = document.querySelectorAll<HTMLElement>(".reveal");
  if (window.IntersectionObserver) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-in");
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -8% 0px" },
    );
    revealed.forEach((el) => observer.observe(el));
  } else {
    revealed.forEach((el) => el.classList.add("is-in"));
  }
</script>

<style>
  .portal-page {
    max-width: var(--measure-wide);
    margin: 0 auto;
    padding: var(--space-tight) 1.5rem var(--space-base);
    overflow-x: clip;
  }

  .portal-kicker {
    margin-bottom: 0.75rem;
    color: var(--seal);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* ---------------------------------------------------------------- hero */

  .portal-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: stretch;
    gap: var(--grid-gap);
    /* 视觉区右出血：补掉容器左右 padding 后贴到视口右缘 */
    margin-right: calc(50% - 50vw);
    margin-bottom: var(--space-tight);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-right: clamp(0rem, 2vw, 2rem);
  }

  .hero-copy h1 {
    max-width: 16ch;
    margin-bottom: 1.25rem;
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: var(--fw-medium);
    line-height: 0.96;
  }

  .hero-lede {
    max-width: 46ch;
    color: var(--ink-70);
    font-size: var(--fs-lede);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.7rem 1.6rem;
    border: 1px solid var(--seal);
    border-radius: var(--r-none);
    background: var(--seal);
    color: var(--paper);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
  }

  .hero-cta:hover {
    background: var(--seal-deep);
    border-color: var(--seal-deep);
    text-decoration: none;
  }

  .hero-textlink {
    color: var(--celadon);
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    text-underline-offset: 4px;
  }

  .hero-textlink:hover {
    color: var(--seal);
    text-decoration: underline;
  }

  .hero-verified {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hairline);
    color: var(--celadon);
  }

  .hero-visual {
    display: flex;
    flex-direction: column;
    min-height: 360px;
    margin: 0;
  }

  .hero-visual img {
    flex: 1 1 auto;
    width: 100%;
    min-height: 0;
    object-fit: cover;
    border-radius: var(--r-media);
  }

  .hero-visual figcaption {
    flex: none;
    padding-top: 0.7rem;
    color: var(--ink-45);
  }

  .hero-hint {
    margin-top: 0.7rem;
    color: var(--ink-45);
  }

  .carousel-track {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    border-radius: var(--r-media);
    overflow: hidden;
  }

  .carousel-track img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-enter) var(--ease-out);
  }

  .carousel-track img.is-active {
    opacity: 1;
  }

  .carousel-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex: none;
    padding-top: 0.7rem;
  }

  .carousel-label {
    color: var(--ink-70);
  }

  .carousel-dots {
    display: flex;
    gap: 0.4rem;
  }

  .carousel-dots button {
    width: 22px;
    height: 22px;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    position: relative;
  }

  .carousel-dots button::after {
    content: "";
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    background: var(--ink-45);
    transition: background-color var(--dur-base) ease;
  }

  .carousel-dots button.is-active::after {
    background: var(--seal);
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track img {
      transition: none;
    }
  }

  .hero-hint {
    margin-top: 0.7rem;
    color: var(--ink-45);
  }

  .carousel-track {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    border-radius: var(--r-media);
    overflow: hidden;
  }

  .carousel-track img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--dur-enter) var(--ease-out);
  }

  .carousel-track img.is-active {
    opacity: 1;
  }

  .carousel-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex: none;
    padding-top: 0.7rem;
  }

  .carousel-label {
    color: var(--ink-70);
  }

  .carousel-dots {
    display: flex;
    gap: 0.4rem;
  }

  .carousel-dots button {
    width: 22px;
    height: 22px;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    position: relative;
  }

  .carousel-dots button::after {
    content: "";
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    background: var(--ink-45);
    transition: background-color var(--dur-base) ease;
  }

  .carousel-dots button.is-active::after {
    background: var(--seal);
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track img {
      transition: none;
    }
  }

  /* ------------------------------------------------------------ sections */

  .portal-section {
    padding-top: var(--space-tight);
    border-top: 1px solid var(--hairline);
    margin-bottom: var(--space-base);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    gap: var(--grid-gap);
    align-items: start;
    margin-bottom: var(--space-tight);
  }

  .section-heading .portal-kicker {
    margin-bottom: 0;
    padding-top: 0.35rem;
  }

  .section-heading-copy {
    max-width: var(--measure-read);
  }

  .section-heading h2 {
    max-width: 26ch;
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: var(--fw-medium);
    line-height: 1.08;
  }

  .section-heading p:not(.portal-kicker) {
    max-width: 52ch;
    margin-top: 0.75rem;
    color: var(--ink-70);
  }

  .section-foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: var(--space-tight);
    padding-top: 1rem;
    border-top: 1px solid var(--hairline);
  }

  /* --------------------------------------------------- payment quick row */

  .payment-quick-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem var(--grid-gap);
    margin-bottom: var(--space-tight);
    padding: 0;
    list-style: none;
  }

  .payment-quick {
    display: block;
    color: var(--ink);
    text-decoration: none;
  }

  .payment-quick:hover {
    text-decoration: none;
  }

  .payment-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    max-width: 100%;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    background: var(--surface);
    transition: border-color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }

  .payment-quick:hover .payment-chip {
    border-color: var(--seal);
    background: var(--seal-tint);
  }

  .payment-chip-eyebrow {
    flex: none;
    color: var(--seal);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .payment-chip strong {
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    line-height: 1.3;
  }

  .payment-quick-text {
    display: block;
    margin-top: 0.5rem;
    color: var(--ink-45);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  /* ------------------------------------------------ payment guide cards */
  /* 7 / 5 非等分，打破连续三等分 */

  .payment-guides-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--grid-gap);
  }

  .payment-guide-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 128px;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--hairline);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }

  .payment-guide-card:hover {
    border-color: var(--seal);
    box-shadow: var(--sh-sm);
    text-decoration: none;
  }

  .payment-guide-card h3 {
    margin-bottom: 0.4rem;
    font-size: var(--fs-h4);
    font-weight: var(--fw-semibold);
    line-height: 1.25;
  }

  .payment-guide-card p {
    color: var(--ink-70);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }

  /* ------------------------------------------------------------ 卡片差异 */
  /* start-card：最大权重，图上文下，硬边投影 */

  .start-grid {
    display: grid;
    grid-template-columns: 8fr 4fr;
    gap: var(--grid-gap);
  }

  .start-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }

  .start-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--sh-hard);
    text-decoration: none;
  }

  .start-card img {
    flex: none;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .start-card:first-child {
    grid-row: span 2;
  }

  .start-card:first-child img {
    flex: 1 1 auto;
    min-height: 240px;
    aspect-ratio: auto;
  }

  .start-card-copy {
    flex: none;
    padding: 1.15rem 1.25rem 1.35rem;
  }

  .start-card span {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--seal);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .start-card h3 {
