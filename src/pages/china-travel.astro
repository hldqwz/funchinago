<script>
  (function initCarousel() {
    document.documentElement.classList.add("js");
    const root = document.querySelector("[data-carousel]");
    if (!root) return;

    const slides = Array.prototype.slice.call(root.querySelectorAll(".carousel-track img"));
    const dots = Array.prototype.slice.call(root.querySelectorAll("[data-carousel-dot]"));
    const caption = root.querySelector("[data-carousel-caption]");
    if (slides.length < 2) return;

    const labels = slides.map((img) => img.getAttribute("alt") || "");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let index = 0;
    let timer = null;

    function show(next) {
      index = (next + slides.length) % slides.length;
      slides.forEach((el, i) => el.classList.toggle("is-active", i === index));
      dots.forEach((dot, i) => {
        dot.classList.toggle("is-active", i === index);
        dot.setAttribute("aria-pressed", String(i === index));
      });
      if (caption && labels[index]) {
        caption.textContent = root.querySelectorAll("[data-carousel-dot]")[index].getAttribute("aria-label").replace(/^Show /, "");
      }
    }

    function start() {
      if (reduced || timer) return;
      timer = window.setInterval(() => show(index + 1), 6000);
    }

    function stop() {
      if (timer) window.clearInterval(timer);
      timer = null;
    }

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        stop();
        show(i);
        start();
      });
    });

    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", start);
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));

    start();
  })();
</script>

