---
// src/pages/discuss.astro
import Layout from "../layouts/Layout.astro";
import { useTranslations } from "../i18n";
import GiscusComments from "../components/GiscusComments.astro";

const locale = "en";
const t = useTranslations(locale);
---

<Layout title="Discussion Board" lang={locale}>
  <div class="container-narrow" style="padding-top: 2rem; padding-bottom: 3rem;">
    <h1 style="font-size: 1.65rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.5rem;">
      Discussion Board
    </h1>
    <p style="color: var(--text-secondary); margin-bottom: 2rem;">
      Chat about AI models, share your experience, ask questions — anything related to LLM selection and usage.
    </p>

    <GiscusComments mapping="Discussion Board" />
  </div>
</Layout>
