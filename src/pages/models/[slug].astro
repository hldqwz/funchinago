---
// src/pages/models/[slug].astro — 模型详情（英文版）
import Layout from "../../layouts/Layout.astro";
import { useTranslations } from "../../i18n";
import type { ModelData } from "../../types";

export async function getStaticPaths() {
  try {
    const raw = await import("../../data/models.json");
    const models: ModelData[] = raw.default?.models || raw.models || [];
    return models.map((m) => ({
      params: { slug: m.canonical_name },
    }));
  } catch {
    return [];
  }
}

const locale = "en";
const t = useTranslations(locale);
const { slug } = Astro.params;

let model: ModelData | undefined;
try {
  const raw = await import("../../data/models.json");
  const models: ModelData[] = raw.default?.models || raw.models || [];
  model = models.find((m) => m.canonical_name === slug);
} catch {}

if (!model) return Astro.redirect("/", 404);

// ── Helpers ──
function priceOR(side: "prompt" | "completion"): number | null {
  const p = model?.platforms?.openrouter?.pricing;
  if (!p) return null;
  return parseFloat(p[side] || "0") * 1_000_000;
}
function priceGR(side: "prompt" | "completion"): number | null {
  const p = model?.platforms?.groq?.pricing;
  if (!p) return null;
  return side === "prompt" ? p.prompt_per_m ?? 0 : p.completion_per_m ?? 0;
}
function priceSF(side: "prompt" | "completion"): number | null {
  const p = model?.platforms?.siliconflow?.pricing;
  if (!p) return null;
  return side === "prompt" ? p.prompt_per_m ?? 0 : p.completion_per_m ?? 0;
}
function priceBL(side: "prompt" | "completion"): number | null {
  return null;
}
function formatTokens(n: number | null | undefined): string {
  if (!n) return "—";
  if (n >= 1e12) return (n / 1e12).toFixed(1) + "T";
  if (n >= 1e9) return (n / 1e9).toFixed(1) + "B";
  if (n >= 1e6) return (n / 1e6).toFixed(1) + "M";
  if (n >= 1e3) return (n / 1e3).toFixed(0) + "K";
  return n.toString();
}
function getCtx(plat: "openrouter" | "groq" | "siliconflow" | "bailian"): number {
  return Math.round((model?.platforms?.[plat]?.context_length || 0) / 1024);
}
function getRank(): number | null {
  return model?.platforms?.openrouter?.rank ?? null;
}
function getUsage(): number | null {
  return model?.platforms?.openrouter?.usage_tokens ?? null;
}
function getTrend(): string {
  return model?.platforms?.openrouter?.trend || "";
}

const rank = getRank();
const ctxOR = getCtx("openrouter");
const ctxGR = getCtx("groq");
const ctxSF = getCtx("siliconflow");
const ctxBL = getCtx("bailian");
const maxCtx = ctxOR || ctxGR || ctxSF || ctxBL;

const orInput = priceOR("prompt");
const orOutput = priceOR("completion");
const tjInput = priceGR("prompt");
const tjOutput = priceGR("completion");
const sfInput = priceSF("prompt");
const sfOutput = priceSF("completion");
const blInput = priceBL("prompt");
const blOutput = priceBL("completion");

// Best available prices
const bestInput = [orInput, tjInput, sfInput, blInput].filter(p => p !== null) as number[];
const bestOutput = [orOutput, tjOutput, sfOutput, blOutput].filter(p => p !== null) as number[];
const avgInput = bestInput.length > 0 ? Math.min(...bestInput) : null;
const avgOutput = bestOutput.length > 0 ? Math.min(...bestOutput) : null;
const roundtrip = avgInput !== null && avgOutput !== null ? avgInput + avgOutput : null;

const hasOR = model?.platforms?.openrouter != null;
const hasGR = model?.platforms?.groq != null;
const hasSF = model?.platforms?.siliconflow != null;
const hasBL = model?.platforms?.bailian != null;
---

<Layout title={`${model.name} — Model Details`} description={model.description} lang={locale}>
  <div class="container-narrow" style="padding-top: 2rem;">
    <!-- Breadcrumb -->
    <a href="/" style="font-size: 0.85rem; color: var(--text-tertiary); display: inline-flex; align-items: center; gap: 0.25rem;">
      ← {t("detail.back")}
    </a>

    <!-- Header -->
    <div style="margin-top: 1rem; margin-bottom: 2rem;">
      <h1 style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em;">
        {rank && <span style="margin-right: 0.5rem;">#{rank}</span>}
        {model.name}
      </h1>
      {model.platforms?.openrouter?.top_provider?.name && (
        <span class="badge badge-blue" style="margin-top: 0.4rem; font-size: 0.8rem;">
          {model.platforms.openrouter.top_provider.name}
        </span>
      )}
      <p style="color: var(--text-secondary); margin-top: 0.75rem; line-height: 1.7;">
        {model.description}
      </p>
    </div>

    <!-- Stats -->
    <div class="stat-grid" style="margin-bottom: 1.5rem;">
      <div class="stat-tile">
        <div class="stat-value" style="color: var(--accent);">{rank ? `#${rank}` : "—"}</div>
        <div class="stat-label">Rank</div>
      </div>
      <div class="stat-tile">
        <div class="stat-value" style="color: var(--gold); font-size: 1.3rem;">{maxCtx.toLocaleString()}K</div>
        <div class="stat-label">Context Window</div>
      </div>
      <div class="stat-tile">
        <div class="stat-value" style="color: var(--green); font-size: 1.3rem;">{avgInput !== null ? `$${avgInput.toFixed(2)}` : "—"}</div>
        <div class="stat-label">Min Input /1M</div>
      </div>
      <div class="stat-tile">
        <div class="stat-value" style="color: var(--green); font-size: 1.3rem;">{avgOutput !== null ? `$${avgOutput.toFixed(2)}` : "—"}</div>
        <div class="stat-label">Min Output /1M</div>
      </div>
    </div>

    <!-- Two-column info -->
    <div class="model-info-grid">
      <div class="card" style="padding: 1.25rem;">
        <h3 style="font-size: 0.85rem; font-weight: 700; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">
          {t("detail.model_info")}
        </h3>
        <table style="width: 100%;">
          <tbody>
            <tr style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid var(--border-light);">
              <td style="color: var(--text-tertiary); font-size: 0.85rem; padding: 0;">{t("detail.model_id")}</td>
              <td style="font-size: 0.85rem; font-family: monospace; padding: 0;">{model.canonical_name}</td>
            </tr>
            {model.platforms?.openrouter?.architecture?.modality && (
              <tr style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid var(--border-light);">
                <td style="color: var(--text-tertiary); font-size: 0.85rem; padding: 0;">{t("detail.modality")}</td>
                <td style="font-size: 0.85rem; padding: 0;">{model.platforms.openrouter.architecture.modality}</td>
              </tr>
            )}
            {model.platforms?.openrouter?.top_provider?.name && (
              <tr style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid var(--border-light);">
                <td style="color: var(--text-tertiary); font-size: 0.85rem; padding: 0;">{t("detail.provider")}</td>
                <td style="font-size: 0.85rem; font-weight: 600; padding: 0;">{model.platforms.openrouter.top_provider.name}</td>
              </tr>
            )}
            <tr style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid var(--border-light);">
              <td style="color: var(--text-tertiary); font-size: 0.85rem; padding: 0;">{t("detail.context")}</td>
              <td style="font-size: 0.85rem; font-weight: 600; padding: 0;">{maxCtx.toLocaleString()}K tokens</td>
            </tr>
            <tr style="display: flex; justify-content: space-between; padding: 0.5rem 0;">
              <td style="color: var(--text-tertiary); font-size: 0.85rem; padding: 0;">Platforms</td>
              <td style="font-size: 0.85rem; font-weight: 600; padding: 0;">
                {[hasOR && "OR", hasGR && "GR", hasSF && "SF", hasBL && "BL"].filter(Boolean).join(", ") || "—"}
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="card" style="padding: 1.25rem;">
        <h3 style="font-size: 0.85rem; font-weight: 700; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">
          {t("detail.usage_rank")}
        </h3>
        <table style="width: 100%;">
          <tbody>
            <tr style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid var(--border-light);">
              <td style="color: var(--text-tertiary); font-size: 0.85rem; padding: 0;">{t("detail.rank")}</td>
              <td style="font-size: 0.85rem; font-weight: 700; padding: 0;">
                {rank ? `#${rank}` : t("detail.no_rank")}
              </td>
            </tr>
            {hasOR && (
              <>
                <tr style="display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px solid var(--border-light);">
                  <td style="color: var(--text-tertiary); font-size: 0.85rem; padding: 0;">{t("detail.weekly_usage")}</td>
                  <td style="font-size: 0.85rem; font-weight: 600; padding: 0;">{formatTokens(getUsage())}</td>
                </tr>
                {getTrend() && (
                  <tr style="display: flex; justify-content: space-between; padding: 0.5rem 0;">
                    <td style="color: var(--text-tertiary); font-size: 0.85rem; padding: 0;">{t("detail.trend")}</td>
                    <td style="font-size: 0.85rem; font-weight: 600; padding: 0;">
                      <span class={`badge ${getTrend().startsWith("-") ? "badge-red" : "badge-green"}`}>
                        {getTrend().startsWith("-") ? "↓" : "↑"} {getTrend()}
                      </span>
                    </td>
                  </tr>
                )}
              </>
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Cross-Platform Pricing Table -->
    <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 1.5rem;">
      <div style="padding: 1.25rem 1.25rem 0.5rem;">
        <h3 style="font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary);">
          {t("detail.cross_platform")}
        </h3>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Platform</th>
              <th style="text-align: right;">Input /1M</th>
              <th style="text-align: right;">Output /1M</th>
              <th style="text-align: right;">Context</th>
              <th>Model ID</th>
            </tr>
          </thead>
          <tbody>
            {hasOR && (
              <tr>
                <td style="font-weight: 600;">
                  <span class="badge badge-blue badge-platform" style="font-size: 0.8rem;">OR</span>
                  OpenRouter
                </td>
                <td style="text-align: right; font-weight: 600;">${orInput !== null ? orInput.toFixed(3) : "—"}</td>
                <td style="text-align: right; font-weight: 600;">${orOutput !== null ? orOutput.toFixed(3) : "—"}</td>
                <td style="text-align: right;">{ctxOR > 0 ? `${ctxOR.toLocaleString()}K` : "—"}</td>
                <td style="font-family: monospace; font-size: 0.8rem; max-width: 200px; overflow: hidden; text-overflow: ellipsis;">
                  {model.platforms.openrouter.model_id}
                </td>
              </tr>
            )}
            {hasGR && (
              <tr>
                <td style="font-weight: 600;">
                  <span class="badge badge-purple badge-platform" style="font-size: 0.8rem;">GR</span>
                  Groq
                </td>
                <td style="text-align: right; font-weight: 600;">${tjInput !== null ? tjInput.toFixed(3) : "—"}</td>
                <td style="text-align: right; font-weight: 600;">${tjOutput !== null ? tjOutput.toFixed(3) : "—"}</td>
                <td style="text-align: right;">{ctxGR > 0 ? `${ctxGR.toLocaleString()}K` : "—"}</td>
                <td style="font-family: monospace; font-size: 0.8rem; max-width: 200px; overflow: hidden; text-overflow: ellipsis;">
                  {model.platforms.groq.model_id}
                </td>
              </tr>
            )}
            {hasSF && (
              <tr>
                <td style="font-weight: 600;">
                  <span class="badge badge-orange badge-platform" style="font-size: 0.8rem;">SF</span>
                  SiliconFlow
                </td>
                <td style="text-align: right; font-weight: 600;">${sfInput !== null ? sfInput.toFixed(3) : "—"}</td>
                <td style="text-align: right; font-weight: 600;">${sfOutput !== null ? sfOutput.toFixed(3) : "—"}</td>
                <td style="text-align: right;">{ctxSF > 0 ? `${ctxSF.toLocaleString()}K` : "—"}</td>
                <td style="font-family: monospace; font-size: 0.8rem; max-width: 200px; overflow: hidden; text-overflow: ellipsis;">
                  {model.platforms.siliconflow.model_id}
                </td>
              </tr>
            )}
            {hasBL && (
              <tr>
                <td style="font-weight: 600;">
                  <span class="badge badge-teal badge-platform" style="font-size: 0.8rem;">BL</span>
                  Bailian
                </td>
                <td style="text-align: right; font-weight: 600;">—</td>
                <td style="text-align: right; font-weight: 600;">—</td>
                <td style="text-align: right;">{ctxBL > 0 ? `${ctxBL.toLocaleString()}K` : "—"}</td>
                <td style="font-family: monospace; font-size: 0.8rem; max-width: 200px; overflow: hidden; text-overflow: ellipsis;">
                  {model.platforms.bailian.model_id}
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Value analysis -->
    {roundtrip !== null && (
      <div class="stat-grid" style="margin-bottom: 1.5rem;">
        <div class="stat-tile">
          <div style="font-size: 0.8rem; color: var(--text-tertiary);">{t("detail.input_price")}</div>
          <div style="font-size: 1.4rem; font-weight: 700; color: var(--green);">${avgInput!.toFixed(3)}</div>
          <div style="font-size: 0.75rem; color: var(--text-tertiary);">/ 1M tokens</div>
        </div>
        <div class="stat-tile">
          <div style="font-size: 0.8rem; color: var(--text-tertiary);">{t("detail.output_price")}</div>
          <div style="font-size: 1.4rem; font-weight: 700; color: var(--green);">${avgOutput!.toFixed(3)}</div>
          <div style="font-size: 0.75rem; color: var(--text-tertiary);">/ 1M tokens</div>
        </div>
        <div class="stat-tile">
          <div style="font-size: 0.8rem; color: var(--text-tertiary);">{t("detail.roundtrip")}</div>
          <div style="font-size: 1.4rem; font-weight: 700; color: var(--accent);">${roundtrip.toFixed(2)}</div>
          <div style="font-size: 0.75rem; color: var(--text-tertiary);">/ 1M tokens</div>
        </div>
        <div class="stat-tile">
          <div style="font-size: 0.8rem; color: var(--text-tertiary);">{t("detail.value_rating")}</div>
          <div style="font-size: 1.1rem; font-weight: 700;">
            {roundtrip < 0.5 ? "🟢" : roundtrip < 5 ? "🟡" : "🔴"}
          </div>
          <div style="font-size: 0.75rem; color: var(--text-tertiary);">
            {roundtrip < 0.5 ? t("detail.value_economy") :
             roundtrip < 5 ? t("detail.value_medium") : t("detail.value_premium")}
          </div>
        </div>
      </div>
    )}

    <!-- SEO Section -->
    <section style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border);">
      <h2 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 0.75rem;">
        {t("detail.about_section").replace("{name}", model.name)}
      </h2>
      <div style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.8;">
        <p>
          {model.name} is a large language model {model.platforms?.openrouter?.top_provider?.name ? `by ${model.platforms.openrouter.top_provider.name}` : ""}
          with a {maxCtx.toLocaleString()}K token context window.
          {rank ? ` It currently ranks #${rank} on OpenRouter by API token usage.` : ""}
        </p>
        <p style="margin-top: 1rem;">
          {roundtrip !== null
            ? `The best available input price is $${avgInput!.toFixed(3)}/1M tokens and output price is $${avgOutput!.toFixed(3)}/1M tokens, with a round-trip cost of $${roundtrip.toFixed(2)}/1M tokens.`
            : "Pricing information is not available for this model."}
          {[hasOR, hasGR, hasSF, hasBL].filter(Boolean).length > 1
            ? ` This model is available on ${[hasOR && "OpenRouter", hasGR && "Groq", hasSF && "SiliconFlow", hasBL && "Bailian"].filter(Boolean).join(", ")}.`
            : ""}
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .model-info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 640px) {
    .model-info-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
