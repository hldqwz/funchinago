---
// src/pages/blog/index.astro — 博客列表（英文版）
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

const t = useTranslations();

const posts = await getCollection('blog');
const enPosts = posts.filter(p => p.data.locale === 'en').sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title={t('blog.title')} description={t('blog.subtitle')}>
  <div class="container-narrow" style="padding-top: 2rem;">
    <h1 style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.5rem;">
      {t('blog.title')}
    </h1>
    <p style="color: var(--text-secondary); margin-bottom: 2rem;">{t('blog.subtitle')}</p>

    {enPosts.length === 0 ? (
      <div class="card" style="text-align: center; padding: 3rem; color: var(--text-secondary);">
        {t('blog.no_posts')}
      </div>
    ) : (
      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        {enPosts.map((post) => (
          <article class="card" style="padding: 1.5rem;">
            {post.data.hero_image && (
              <img src={post.data.hero_image} alt={post.data.title} style="width: 100%; height: 180px; object-fit: cover; border-radius: 6px; margin-bottom: 0.75rem;" />
            )}
            <time datetime={post.data.date.toISOString()} style="font-size: 0.8rem; color: var(--text-tertiary);">
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0.4rem 0; line-height: 1.3;">
              <a href={`/blog/${post.id}`} style="color: var(--text); text-decoration: none;">
                {post.data.title}
              </a>
            </h2>
            <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6;">
              {post.data.description}
            </p>
            {post.data.tags && post.data.tags.length > 0 && (
              <div style="display: flex; gap: 0.35rem; margin-top: 0.75rem; flex-wrap: wrap;">
                {post.data.tags.map((tag) => (
                  <span class="badge badge-blue">{tag}</span>
                ))}
              </div>
            )}
            <a href={`/blog/${post.id}`} style="display: inline-block; margin-top: 0.75rem; font-size: 0.85rem; font-weight: 500;">
              {t('blog.read_more')} →
            </a>
          </article>
        ))}
      </div>
    )}
  </div>
</Layout>
