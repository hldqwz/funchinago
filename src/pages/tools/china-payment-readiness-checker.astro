---
import Layout from "../../layouts/ChinaTravelLayout.astro";

const title = "China Payment Readiness Self-Check: Alipay, WeChat Pay, Card or Cash";
const description = "Answer five questions about your cards, verification, and trip length, and get a ranked China payment plan — Alipay, WeChat Pay, physical card, or cash — with the failure risk at each step.";
---

<Layout title={title} description={description}>
  <main class="payment-page">
    <section class="hero-panel">
      <div class="hero-copy">
        <p class="kicker">China Travel Made Easy · Tools</p>
        <h1>China payment readiness self-check</h1>
        <p class="lead">
          Five questions, one ranked answer. Tell us which cards you carry, whether you will
          link one, and how long you are staying — the tool returns your payment order for
          Alipay, WeChat Pay, physical card, and cash, with the failure risk attached to
          every step.
        </p>
        <div class="trust-row" aria-label="Tool properties">
          <span>5 questions</span>
          <span>No sign-up</span>
          <span>No data stored</span>
          <span>Official sources linked</span>
        </div>
        <p class="mono-meta verified-dot">VERIFIED · 17 OCT 2026</p>
      </div>
      <aside class="intro-card">
        <p class="eyebrow">How it works</p>
        <h2>Deterministic by design</h2>
        <p>
          Your answers select one of three plans: the linked-card setup, the card-and-cash
          setup, or the cash-only setup. There is no “it depends” — each plan ranks four
          payment methods and names the failure risk that actually stops travelers.
        </p>
        <p>
          Policy numbers behind the plans (USD 5,000 per transaction, USD 50,000 per year,
          the 3% fee above ¥200) come from People's Bank of China guidance and are verified
          in the <a href="/china-travel/sources/">official source library</a>.
        </p>
      </aside>
    </section>

    <section class="tool-grid">
      <form class="checker-card" data-payment-form novalidate>
        <div class="form-header">
          <p class="eyebrow">Step-by-step check</p>
          <h2>Answer these questions</h2>
          <p>Pick the closest answer. Everything runs in your browser — nothing is sent anywhere.</p>
        </div>

        <fieldset>
          <legend>1. Is your passport on China's visa-free entry list?</legend>
          <label class="option">
            <input type="radio" name="entry" value="visa-free" required />
            <span>Yes — visa-free entry or 240-hour transit</span>
          </label>
          <label class="option">
            <input type="radio" name="entry" value="visa-required" required />
            <span>No — I need a visa</span>
          </label>
          <label class="option">
            <input type="radio" name="entry" value="unsure" required />
            <span>Not sure</span>
          </label>
        </fieldset>

        <fieldset>
          <legend>2. Which card networks are you bringing? (select all that apply)</legend>
          <div class="card-options">
            <label class="option">
              <input type="checkbox" name="cards" value="visa" />
              <span>Visa</span>
            </label>
            <label class="option">
              <input type="checkbox" name="cards" value="mastercard" />
              <span>Mastercard</span>
            </label>
            <label class="option">
              <input type="checkbox" name="cards" value="amex" />
              <span>Amex</span>
            </label>
            <label class="option">
              <input type="checkbox" name="cards" value="jcb" />
              <span>JCB</span>
            </label>
            <label class="option">
              <input type="checkbox" name="cards" value="unionpay" />
              <span>UnionPay</span>
            </label>
            <label class="option">
              <input type="checkbox" name="cards" value="none" />
              <span>No bank card at all</span>
            </label>
          </div>
          <small class="field-error" data-cards-error hidden>Select at least one option.</small>
          <small>
            Visa, Mastercard, and JCB link to payment apps. Amex and UnionPay work at
            international terminals, but app linking is not guaranteed for every card.
          </small>
        </fieldset>

        <fieldset>
          <legend>3. Have you completed real-name verification (passport check) in the payment app?</legend>
          <label class="option">
            <input type="radio" name="verification" value="done" required />
            <span>Yes — already finished outside China</span>
          </label>
          <label class="option">
            <input type="radio" name="verification" value="pending" required />
            <span>No — not yet</span>
          </label>
          <label class="option">
            <input type="radio" name="verification" value="unknown" required />
            <span>I do not know what this means</span>
          </label>
        </fieldset>

        <fieldset>
          <legend>4. Are you willing to link an international card to a payment app?</legend>
          <label class="option">
            <input type="radio" name="linking" value="willing" required />
            <span>Yes — before departure or on arrival</span>
          </label>
          <label class="option">
            <input type="radio" name="linking" value="unwilling" required />
            <span>No — I prefer not to link a card</span>
          </label>
        </fieldset>

        <fieldset>
          <legend>5. How long will you stay in China?</legend>
          <label class="option">
            <input type="radio" name="stay" value="short" required />
            <span>7 days or less</span>
          </label>
          <label class="option">
            <input type="radio" name="stay" value="medium" required />
            <span>8–14 days</span>
          </label>
          <label class="option">
            <input type="radio" name="stay" value="long" required />
            <span>15–30 days</span>
          </label>
          <label class="option">
            <input type="radio" name="stay" value="extended" required />
            <span>More than 30 days</span>
          </label>
        </fieldset>

        <button type="submit" class="button-primary">Build my payment plan</button>
      </form>

      <div class="result-card result-placeholder" data-payment-result aria-live="polite">
        <p class="eyebrow">Your payment plan</p>
        <h2>Answer the five questions</h2>
        <p>
          Your ranked plan — Alipay, WeChat Pay, physical card, and cash in order — appears
          here with the failure risk for each step.
        </p>
      </div>
    </section>

    <section class="explain-grid">
      <article class="info-card">
        <p class="eyebrow">What this tool checks</p>
        <h2>Five inputs, three plans</h2>
        <ul>
          <li><strong>Entry route</strong> — visa-free entry gives you a short runway; a visa application gives you a long one.</li>
          <li><strong>Card networks</strong> — Visa, Mastercard, and JCB can link to payment apps; Amex and UnionPay stay POS-first.</li>
          <li><strong>Verification status</strong> — unfinished real-name verification is the most common blocker, and it is much easier at home.</li>
          <li><strong>Linking willingness</strong> — refusing to link a card rewrites the whole plan toward cash and card terminals.</li>
          <li><strong>Trip length</strong> — longer trips need a bigger cash buffer and an eye on the USD 50,000 annual cap.</li>
        </ul>
      </article>

      <article class="info-card caution-card">
        <p class="eyebrow">Important limitation</p>
        <h2>This is a prep plan, not a payment guarantee</h2>
        <p>
          Fees, card support, and app features change often. The plans use current published
          guidance — People's Bank of China limits, the roughly 3% cross-border fee above
          ¥200, and issuer-side caps — but confirm the live numbers inside your app and with
          your bank before you rely on them.
        </p>
      </article>
    </section>

    <section class="explain-grid explain-grid--three">
      <article class="info-card">
        <p class="eyebrow">Real use cases</p>
        <h2>When to run this check</h2>
        <ul>
          <li><strong>Two weeks before flying</strong> — You have a Visa card and want to know whether to start with Alipay or WeChat Pay.</li>
          <li><strong>Refusing to link a card</strong> — You want the honest cost: which daily scenes break without a payment app.</li>
          <li><strong>Traveling with no bank card</strong> — You need the arrival-day path to a local card, not a generic “download an app” tip.</li>
          <li><strong>Long stay over 30 days</strong> — You need to know when the annual cap and local-account questions start to matter.</li>
        </ul>
      </article>

      <article class="info-card caution-card">
        <p class="eyebrow">Limitation</p>
        <h2>Editorial guidance, not official policy</h2>
        <p>
          The ranking is a planning heuristic built on published guidance. Your bank, your
          card issuer, and the current app version have the final word. For policy-sensitive
          decisions, check the <a href="/china-travel/sources/">official source library</a>
          before you book or fly.
        </p>
      </article>

      <article class="info-card">
        <p class="eyebrow">Related tools</p>
        <h2>Finish the rest of the setup</h2>
        <ul>
          <li><a href="/tools/china-travel-checklist/">China Travel Checklist Generator</a></li>
          <li><a href="/tools/china-city-picker/">China City Picker</a></li>
          <li><a href="/china-travel/tools/">All China travel tools</a></li>
        </ul>
      </article>
    </section>

    <section class="related-section">
      <p class="eyebrow">Related payment guides</p>
      <h2>Read the detail behind each method</h2>
      <ul class="related-list">
        <li>
          <a href="/china-travel/articles/how-to-pay-in-china-tourist/">
            <strong>How to Pay in China as a Tourist</strong>
            <small>The payment hub: Alipay, WeChat Pay, cards, cash, and the backup order when something fails.</small>
          </a>
        </li>
        <li>
          <a href="/china-travel/articles/how-to-use-alipay-in-china-foreigner/">
            <strong>How to Use Alipay in China as a Foreigner</strong>
            <small>Card linking, verification, and the three failures tourists hit most.</small>
          </a>
        </li>
        <li>
          <a href="/china-travel/articles/how-to-use-wechat-pay-in-china-foreigner/">
            <strong>WeChat Pay for Foreigners</strong>
            <small>International card setup, the 2026 fee waiver, and the fix order at real counters.</small>
          </a>
        </li>
        <li>
          <a href="/china-travel/articles/wechat-pay-vs-alipay-for-tourists-china/">
            <strong>Alipay vs WeChat Pay for Tourists</strong>
            <small>Which app to set up first, compared across seven decision factors.</small>
          </a>
        </li>
      </ul>
    </section>
  </main>

  <script>
    const form = document.querySelector('[data-payment-form]');
    const resultCard = document.querySelector('[data-payment-result]');
    const placeholderHTML = resultCard.innerHTML;
    const cardsError = form.querySelector('[data-cards-error]');
    const noneBox = form.querySelector('input[name="cards"][value="none"]');
    const otherCardBoxes = Array.from(form.querySelectorAll('input[name="cards"]:not([value="none"])'));

    const APP_NETWORKS = ['visa', 'mastercard', 'jcb'];
    const NETWORK_LABELS = {
      visa: 'Visa',
      mastercard: 'Mastercard',
      amex: 'Amex',
      jcb: 'JCB',
      unionpay: 'UnionPay',
    };
    const CASH_BY_STAY = {
      short: '¥500',
      medium: '¥800',
      long: '¥1,200',
      extended: '¥1,500',
    };
    const ENTRY_NOTE = {
      'visa-free':
        'Visa-free entry: your runway is short. Finish every setup step before departure — there is no long stay to fix problems in.',
      'visa-required':
        'Visa required: use the application window to finish verification while your phone number and bank access are stable.',
      unsure:
        'Entry status unclear: prepare the full setup — it covers both the visa-free and visa-required paths.',
    };
    const STAY_NOTE = {
      short: 'Seven days or less: keep the setup light and carry ¥500 in cash for day one.',
      medium:
        'Eight to fourteen days: the backup stack earns its keep around day three, when the first failures usually hit.',
      long:
        'Fifteen to thirty days: check your bank’s daily cap and the USD 50,000 annual limit before any big purchase.',
      extended:
        'Over 30 days: open a local UnionPay account early and track spending against the USD 50,000 annual limit.',
    };

    function formatNetworks(values) {
      return values.map((value) => NETWORK_LABELS[value]).join(' + ');
    }

    function buildPlan(answers) {
      const cards = answers.cards;
      const appCards = cards.filter((value) => APP_NETWORKS.includes(value));
      const cardList = formatNetworks(cards);
      const appCardList = formatNetworks(appCards);
      const cash = CASH_BY_STAY[answers.stay];
      const canLink = answers.linking === 'willing' && appCards.length > 0;
      const verificationDone = answers.verification === 'done';

      const plan = {
        verdict: '',
        steps: [],
        checklist: [],
        notes: [ENTRY_NOTE[answers.entry], STAY_NOTE[answers.stay]],
      };

      if (canLink) {
        plan.verdict =
          'Your payment order: Alipay first, WeChat Pay second, physical card third, cash last.';
        plan.steps.push({
          method: 'Alipay',
          role: 'Primary payment app',
          action: verificationDone
            ? `Verification is done — link your ${appCardList} card and run one small test payment before departure.`
            : `Link your ${appCardList} card and finish real-name verification before departure.`,
          risk: verificationDone
            ? 'The failure point moves to your bank: tell the issuer you are traveling so the card link is not blocked as fraud.'
            : 'Passport verification and bank SMS are the two failure points. Finish them at home, where your phone number and bank app still work.',
        });
        plan.steps.push({
          method: 'WeChat Pay',
          role: 'Second app and service layer',
          action:
            'Link the same card as a backup route for mini programs, ride-hailing, and restaurant QR ordering.',
          risk:
            'Card and account checks differ by issuer. Run one small test payment before departure, not at your first restaurant counter.',
        });
        plan.steps.push({
          method: 'Physical card',
          role: 'Hotels, malls, big tickets',
          action: `Carry your ${cardList} card for hotels, malls, and any purchase over ¥200.`,
          risk:
            'In-app purchases over ¥200 carry a roughly 3% cross-border fee, and your bank’s daily cap binds before the USD 5,000 policy limit.',
        });
        plan.steps.push({
          method: 'Cash',
          role: 'Arrival-day backup',
          action: `Carry ${cash} in RMB for day one, weak-network moments, and cash-only stalls.`,
          risk:
            'Cash is a bridge, not a plan: it fails at every QR-only counter and every online booking.',
        });
        plan.checklist.push(
          'Download Alipay and register with a phone number you can still use abroad.',
          verificationDone
            ? 'Verification is done — link your card and run one small test payment.'
            : 'Finish passport verification inside Alipay before departure.',
          'Set up WeChat Pay with the same card as your second route.',
          'Tell your bank you are traveling to China.',
          `Pack your physical card and ${cash} in RMB.`
        );
      } else if (cards.length > 0) {
        plan.verdict =
          'Your payment order: physical card first, cash second, payment apps last.';
        plan.steps.push({
          method: 'Physical card',
          role: 'Primary payment method',
          action: `Use your ${cardList} card at hotels, malls, airports, and international card terminals.`,
          risk:
            'Street food, metro gates, convenience stores, and QR menus are card-dead zones — they need an app or cash.',
        });
        plan.steps.push({
          method: 'Cash',
          role: 'Daily spending money',
          action: `Carry ${cash} or more — without a linked app, this is how you buy breakfast, water, and metro rides.`,
          risk:
            'Running out means hunting for a bank branch mid-trip. Carry more than you think you need.',
        });
        plan.steps.push({
          method: 'Alipay and WeChat Pay',
          role: 'Install, but spending depends on the link',
          action:
            answers.linking === 'unwilling'
              ? 'Install both apps for QR menus, ride-hailing, and hotel chat. Without a linked card they cannot complete a payment.'
              : `Install Alipay and link your ${cardList} card at the airport service desk on arrival day.`,
          risk:
            answers.linking === 'unwilling'
              ? 'Every QR-only stall becomes a dead end — that is the trade-off you accepted by not linking a card.'
              : `${cardList} support inside Alipay and WeChat Pay varies by issuer and app version. If the link is refused, you stay on card and cash for the whole trip.`,
        });
        plan.checklist.push(
          `Pack your ${cardList} card and at least ${cash} in RMB.`,
          'Tell your bank you are traveling so the card is not flagged.',
          'Install Alipay and WeChat Pay for QR menus, ride-hailing, and hotel chat.',
          'Confirm your hotel accepts foreign cards before check-in day.'
        );
      } else {
        plan.verdict =
          'Your payment order: cash first, a local UnionPay card on arrival second, payment apps third.';
        plan.steps.push({
          method: 'Cash',
          role: 'Your only day-one method',
          action: `Exchange at least ${cash} in RMB before you fly and keep it split between two places.`,
          risk:
            'With no card you have no ATM withdrawal and no backup if cash is lost or stolen.',
        });
        plan.steps.push({
          method: 'Local UnionPay card',
          role: 'Arrival-day fix',
          action:
            'On arrival, open an account with your passport at a Bank of China branch and ask for a UnionPay card.',
          risk:
            'Account-opening rules and English support vary by branch. Budget half a day and bring your passport.',
        });
        plan.steps.push({
          method: 'Alipay and WeChat Pay',
          role: 'After the local card exists',
          action:
            'Once the UnionPay card is active, link it to Alipay first and set up WeChat Pay second.',
          risk:
            'Until the local card exists, both apps are unusable for spending — do not count on them for day one.',
        });
        plan.checklist.push(
          `Exchange at least ${cash} in RMB before you fly.`,
          'Pack your passport — you need it to open a local bank account.',
          'Plan half a day on arrival for the Bank of China branch.',
          'Install Alipay before departure so registration is not the bottleneck later.'
        );
      }

      return plan;
    }

    function renderPlan(plan) {
      const steps = plan.steps
        .map(
          (step, index) => `
          <li class="plan-step${index === 0 ? ' is-primary' : ''}">
            <div class="plan-head">
              <span class="plan-rank">${index + 1}</span>
              <div class="plan-heading">
                <h3>${step.method}</h3>
                <p class="plan-role">${step.role}</p>
              </div>
            </div>
            <p class="plan-action"><strong>Do this:</strong> ${step.action}</p>
            <p class="plan-risk"><strong>Failure risk:</strong> ${step.risk}</p>
          </li>`
        )
        .join('');

      const checklist = plan.checklist.map((item) => `<li>${item}</li>`).join('');
      const notes = plan.notes.map((note) => `<p class="plan-note">${note}</p>`).join('');

      resultCard.classList.remove('result-placeholder');
      resultCard.classList.add('result-plan');
      resultCard.innerHTML = `
        <p class="eyebrow">Your payment plan</p>
        <h2>${plan.verdict}</h2>
        <ol class="plan-list">${steps}</ol>
        <div class="plan-checklist">
          <h3>Before you fly</h3>
          <ul>${checklist}</ul>
        </div>
        ${notes}
        <button type="button" class="button-ghost" data-reset>Start over</button>
        <p class="mono-meta verified-dot plan-verify">VERIFIED · 17 OCT 2026</p>
      `;

      resultCard.querySelector('[data-reset]').addEventListener('click', () => {
        form.reset();
        cardsError.hidden = true;
        resultCard.classList.add('result-placeholder');
        resultCard.classList.remove('result-plan');
        resultCard.innerHTML = placeholderHTML;
      });
    }

    noneBox.addEventListener('change', () => {
      if (noneBox.checked) {
        otherCardBoxes.forEach((box) => {
          box.checked = false;
        });
      }
      cardsError.hidden = true;
    });

    otherCardBoxes.forEach((box) => {
      box.addEventListener('change', () => {
        if (box.checked) {
          noneBox.checked = false;
        }
        cardsError.hidden = true;
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const data = new FormData(form);
      const cards = data.getAll('cards').filter((value) => value !== 'none');
      if (cards.length === 0) {
        cardsError.hidden = false;
        return;
      }
      renderPlan(
        buildPlan({
          entry: data.get('entry'),
          cards,
          verification: data.get('verification'),
          linking: data.get('linking'),
          stay: data.get('stay'),
        })
      );
    });
  </script>
</Layout>

<style>
  .payment-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .hero-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(280px, 0.9fr);
    gap: 1rem;
    align-items: stretch;
    margin-bottom: 1.25rem;
  }

  .hero-copy,
  .intro-card,
  .checker-card,
  .result-card,
  .info-card,
  .related-section {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--r-media);
  }

  .hero-copy {
    padding: 2.2rem;
    background:
      radial-gradient(circle at 14% 12%, var(--seal-tint), transparent 30%),
      radial-gradient(circle at 86% 8%, var(--celadon-tint), transparent 26%),
      var(--surface);
  }

  .kicker,
  .eyebrow {
    color: var(--seal);
    font-weight: var(--fw-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: var(--fs-meta);
    margin-bottom: 0.55rem;
  }

  h1 {
    max-width: 820px;
    font-size: clamp(2rem, 4.6vw, 3.5rem);
    line-height: 1.02;
    margin-bottom: 1rem;
  }

  h2 {
    font-size: var(--fs-h3);
    margin-bottom: 0.55rem;
  }

  h3 {
    font-size: var(--fs-h4);
  }

  .lead {
    max-width: 760px;
    color: var(--ink-70);
    font-size: var(--fs-lede);
  }

  .intro-card {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.75rem;
  }

  .intro-card p {
    color: var(--ink-70);
    font-size: var(--fs-sm);
  }

  .trust-row {
    display: flex;
    gap: 0.55rem;
    flex-wrap: wrap;
    margin-top: 1.4rem;
  }

  .trust-row span {
    border: 1px solid var(--hairline);
    background: var(--paper);
    color: var(--ink);
    padding: 0.45rem 0.7rem;
    border-radius: var(--r-pill);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
  }

  .verified-dot {
    margin-top: 1rem;
    color: var(--celadon);
    font-weight: var(--fw-semibold);
  }

  .tool-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(360px, 0.9fr);
    gap: 1rem;
    align-items: start;
  }

  .checker-card,
  .result-card,
  .info-card,
  .related-section {
    padding: 1.35rem;
  }

  .form-header {
    margin-bottom: 1rem;
  }

  .form-header p {
    color: var(--ink-70);
    font-size: var(--fs-sm);
  }

  fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 1rem;
  }

  legend {
    font-weight: var(--fw-bold);
    margin-bottom: 0.55rem;
    font-size: var(--fs-sm);
  }

  .option {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 44px;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--hairline);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    cursor: pointer;
    margin-bottom: 0.4rem;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .option:hover {
    border-color: var(--seal);
  }

  .option:has(input:checked) {
    border-color: var(--seal);
    background: var(--seal-tint);
  }

  .option input {
    margin: 0;
    accent-color: var(--seal);
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .card-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
    margin-bottom: 0.4rem;
  }

  .card-options .option {
    margin-bottom: 0;
  }

  small {
