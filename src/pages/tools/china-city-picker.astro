---
import Layout from "../../layouts/ChinaTravelLayout.astro";

const title = "China City Picker: Which Chinese City Should You Visit First?";
const description = "Answer 6 quick questions about your travel style and get a personalized recommendation for the best Chinese city to visit first: Beijing, Shanghai, Chengdu, Chongqing, Xi'an, Guilin, or Guangzhou.";
---

<Layout title={title} description={description}>
  <main class="city-page">
    <section class="hero-panel">
      <div class="hero-copy">
        <p class="kicker">China Travel Made Easy · Tools</p>
        <h1>Which Chinese city should you visit first?</h1>
        <p class="lead">
          China has over 600 cities. Narrow it down in 30 seconds: answer a few questions
          and get a personalized city ranking based on your travel style, food preferences,
          and comfort level.
        </p>
        <div class="trust-row">
          <span>44 major cities</span>
          <span>6 questions</span>
          <span>Personalized score</span>
          <span>Guide links included</span>
        </div>
      </div>
      <aside class="intro-card">
        <p class="eyebrow">How it works</p>
        <h2>Score-driven ranking</h2>
        <p>
          Every city is scored on 8 dimensions: culture, modernity, food, nature,
          ease of travel, English-friendliness, first-trip suitability, and visual drama.
          Your answers adjust the weights, and you get a ranked list of your best matches.
        </p>
      </aside>
    </section>

    <section class="tool-grid">
      <form class="checker-card" data-city-form>
        <div class="form-header">
          <p class="eyebrow">Your travel profile</p>
          <h2>Answer these questions</h2>
          <p>All anonymous. Pick the answers that feel right.</p>
        </div>

        <fieldset>
          <legend>What draws you to China? (pick up to 2)</legend>
          <div class="chip-group" data-interest-group>
            <label class="chip"><input type="checkbox" name="interests" value="culture" /> Ancient history &amp; temples</label>
            <label class="chip"><input type="checkbox" name="interests" value="modern" /> Modern skylines &amp; futuristic vibes</label>
            <label class="chip"><input type="checkbox" name="interests" value="food" /> Food adventure</label>
            <label class="chip"><input type="checkbox" name="interests" value="nature" /> Nature &amp; landscapes</label>
          </div>
        </fieldset>

        <label>
          Is this your first trip to China?
          <select name="firstTrip" required>
            <option value="yes" selected>Yes — first time</option>
            <option value="no">No — I have been before</option>
          </select>
        </label>

        <label>
          Your comfort with non-English environments:
          <select name="englishComfort" required>
            <option value="english-friendly" selected>Prefer English-friendly places</option>
            <option value="apps">Fine with translation apps</option>
            <option value="comfortable">Very comfortable regardless</option>
          </select>
        </label>

        <label>
          Food preferences:
          <select name="foodPref" required>
            <option value="any" selected>I will eat anything</option>
            <option value="mild">Prefer milder flavors</option>
            <option value="spicy">Love spicy food</option>
            <option value="vegetarian">Vegetarian or dietary restrictions</option>
          </select>
        </label>

        <label>
          Urban vs. nature:
          <select name="vibePreference" required>
            <option value="mixed" selected>A mix of city and nature</option>
            <option value="urban">Big city energy all the way</option>
            <option value="nature">Escape to nature</option>
          </select>
        </label>

        <label>
          How long will you stay in China?
          <select name="stayLength" required>
            <option value="short">1–3 days</option>
            <option value="medium" selected>4–7 days</option>
            <option value="long">8+ days</option>
          </select>
        </label>

        <button type="submit">Find my city</button>
      </form>

      <div class="result-area" data-city-result>
        <div class="result-placeholder">
          <p class="eyebrow">Your matches</p>
          <h2>Fill out the form</h2>
          <p>Select your travel profile on the left to see your personalized city ranking.</p>
        </div>
      </div>
    </section>

    <section class="explain-grid">
      <article class="info-card">
        <p class="eyebrow">What this tool covers</p>
        <h2>44 major tourist cities</h2>
        <ul>
          <li><strong>Classic first-timers</strong> — Beijing, Shanghai, Xi'an, Guilin, Chengdu</li>
          <li><strong>Hidden gems</strong> — Dunhuang, Zhangjiajie, Kashgar, Dali, Pingyao</li>
          <li><strong>Modern &amp; coastal</strong> — Guangzhou, Shenzhen, Hong Kong, Macau, Xiamen</li>
          <li><strong>Seasonal &amp; scenic</strong> — Sanya, Harbin, Jiuzhaigou, Huangshan, Lhasa</li>
        </ul>
      </article>

      <article class="info-card caution-card">
        <p class="eyebrow">What this tool doesn\'t cover</p>
        <h2>It is not a complete planner</h2>
        <p>
          The City Picker narrows down your options. Once you choose a city, use our
          detailed guides to plan your visa, payment setup, train tickets, and daily
          itinerary. City recommendations are editorial, not official travel advice.
        </p>
      </article>
    </section>

    <section class="explain-grid">
      <article class="info-card">
        <p class="eyebrow">Real use cases</p>
        <h2>When to use this tool</h2>
        <ul>
          <li><strong>First-time visitor choosing Beijing vs Shanghai</strong> — Compare the cultural weight of Beijing against the modern energy of Shanghai.</li>
          <li><strong>Food-focused traveler considering Chengdu or Guangzhou</strong> — Both are food capitals, but the style and intensity differ significantly.</li>
          <li><strong>Nature-focused visitor choosing Guilin or Zhangjiajie</strong> — Get a match based on landscape preference and trip length.</li>
          <li><strong>Short-stay traveler needing a lower-friction city</strong> — Some cities are easier to navigate for first-time visitors with limited time.</li>
        </ul>
      </article>

      <article class="info-card caution-card">
        <p class="eyebrow">Limitation</p>
        <h2>This is editorial route guidance, not official travel advice</h2>
        <p>City scores are based on editorial criteria and your profile answers. Use the result as a starting point, then read our detailed city guides for visa, payment, and transport planning.</p>
      </article>

      <article class="info-card">
        <p class="eyebrow">Related guides</p>
        <h2>Read before you decide</h2>
        <ul>
          <li><a href="/china-travel/articles/beijing-shanghai-chengdu-or-chongqing-which-city-to-visit-first/">Beijing, Shanghai, Chengdu or Chongqing — Which city first?</a></li>
          <li><a href="/china-travel/articles/best-places-to-visit-in-china-first-time/">Best Places to Visit in China for First-Time Visitors</a></li>
          <li><a href="/china-travel/articles/ten-days-in-china-first-time-itinerary/">10 Days in China: First-Time Itinerary</a></li>
        </ul>
      </article>
    </section>
  </main>

  <script type="module" src="/tools/china-city-picker.js"></script>
</Layout>

<style>
  .city-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .hero-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(280px, 0.9fr);
    gap: 1rem;
    align-items: stretch;
    margin-bottom: 1.25rem;
  }

  .hero-copy,
  .intro-card,
  .checker-card,
  .info-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 22px;
    box-shadow: var(--shadow-lg);
  }

  .hero-copy {
    padding: 2.2rem;
    background:
      radial-gradient(circle at 14% 12%, rgba(37, 99, 235, 0.16), transparent 28%),
      radial-gradient(circle at 86% 8%, rgba(245, 158, 11, 0.13), transparent 24%),
      linear-gradient(135deg, var(--surface), var(--surface-hover));
  }

  .kicker, .eyebrow {
    color: var(--accent);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.72rem;
    margin-bottom: 0.55rem;
  }

  h1 {
    max-width: 820px;
    font-size: clamp(1.8rem, 4vw, 3.2rem);
    line-height: 1.06;
    letter-spacing: -0.055em;
    margin-bottom: 1rem;
  }

  h2 {
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    margin-bottom: 0.55rem;
  }

  h3 { margin: 0; }

  .lead, .intro-card p, .info-card p, .form-header p {
    color: var(--text-secondary);
  }

  .lead { max-width: 760px; font-size: 1.05rem; }

  .trust-row {
    display: flex; gap: 0.55rem; flex-wrap: wrap; margin-top: 1.4rem;
  }

  .trust-row span {
    border: 1px solid var(--border);
    background: rgba(255,255,255,0.5);
    color: var(--text);
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .intro-card {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(360px, 0.9fr);
    gap: 1rem;
    align-items: start;
  }

  .checker-card {
    padding: 1.35rem;
    position: sticky;
    top: 1rem;
  }

  .form-header { margin-bottom: 1rem; }

  fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 0.9rem;
  }

  legend {
    font-weight: 800;
    margin-bottom: 0.55rem;
    font-size: 0.95rem;
  }

  .chip-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45rem;
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.6rem 0.8rem;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s;
    background: var(--search-bg);
    min-height: 44px;
  }

  .chip:has(input:checked) {
    border-color: var(--accent);
    background: rgba(37, 99, 235, 0.08);
  }

  .chip input { 
    margin: 0; 
    accent-color: var(--accent);
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  label {
    display: grid; gap: 0.38rem;
    font-weight: 800; margin-bottom: 0.9rem;
  }

  select, input {
    width: 100%;
    border: 1px solid var(--border);
    background: var(--search-bg);
    color: var(--text);
    border-radius: 12px;
    padding: 0.78rem 0.85rem;
    font: inherit; font-weight: 600;
  }

  button {
    width: 100%;
    border: 0;
    border-radius: 14px;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: white;
    padding: 0.9rem 1rem;
    font: inherit; font-weight: 900;
    cursor: pointer;
    box-shadow: var(--shadow-lg);
    margin-top: 0.25rem;
  }

  /* ── Result area ── */
  .result-area { min-height: 400px; }

  .result-placeholder {
    background: var(--surface);
    border: 2px dashed var(--border);
    border-radius: 22px;
    padding: 2.5rem 1.5rem;
    text-align: center;
    color: var(--text-secondary);
  }

  .result-placeholder h2 { margin-top: 0.5rem; }

  .result-placeholder.error {
    border-color: rgba(220, 38, 38, 0.3);
    background: rgba(220, 38, 38, 0.04);
  }

  .cl-result-header {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 1.35rem;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.06), var(--surface));
    margin-bottom: 1rem;
  }

  .cl-result-header h2 { font-size: 1.45rem; margin: 0.4rem 0 0.5rem; }

  .cl-disclaimer {
    font-size: 0.85rem;
    color: var(--text-tertiary);
  }

  /* ── City cards ── */
  .city-list { display: grid; gap: 0.75rem; }

  .city-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 1.2rem;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .city-card.top-pick {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.15);
  }

  .city-card.tier-excellent { border-left: 4px solid #22c55e; }
  .city-card.tier-great { border-left: 4px solid #3b82f6; }
  .city-card.tier-good { border-left: 4px solid #f59e0b; }
  .city-card.tier-ok { border-left: 4px solid var(--border); }

  .top-badge {
    position: absolute;
    top: -10px;
    right: 1rem;
    background: var(--accent);
    color: #fff;
    border-radius: 999px;
    padding: 0.28rem 0.65rem;
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .city-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .city-rank {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--text);
    color: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 1rem;
  }

  .city-head-text {
    flex: 1;
    min-width: 0;
  }

  .city-head-text h3 {
    font-size: 1rem;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0;
  }

  .city-head-text h3 small {
    font-weight: 400;
    color: var(--text-tertiary);
    font-size: 0.8rem;
    margin-left: 0.2rem;
  }

  .city-tagline {
    font-size: 0.78rem;
    color: var(--text-secondary);
    margin-top: 0.1rem;
  }

  .city-score {
    flex-shrink: 0;
    text-align: center;
    min-width: 48px;
  }

  .city-score-num {
    display: block;
    font-size: 1.35rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text);
  }

  .city-score-label {
    font-size: 0.65rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .city-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .city-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .meta-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 800;
    color: var(--accent);
    display: block;
    margin-bottom: 0.3rem;
  }

  .city-best {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .city-best ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.18rem;
  }

  .city-best li::before { content: '→ '; }

  .city-tags-display { min-width: 0; }

  .tag-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .tag-badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.18rem 0.5rem;
    border-radius: 6px;
    background: var(--accent-light);
    color: var(--accent);
    border: 1px solid rgba(161, 77, 43, 0.15);
  }

  .city-links {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    padding-top: 0.25rem;
    border-top: 1px solid var(--border-light);
  }

  .guide-link {
    font-size: 0.76rem;
    font-weight: 700;
    border-radius: 999px;
    padding: 0.3rem 0.65rem;
    text-decoration: none;
    background: rgba(37, 99, 235, 0.08);
    color: #1d4ed8;
  }

  .guide-link:hover { text-decoration: none; background: rgba(37, 99, 235, 0.15); }

  .city-card.top-pick {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.15);
  }

  .city-card.tier-excellent { border-left: 4px solid #22c55e; }
  .city-card.tier-great { border-left: 4px solid #3b82f6; }
  .city-card.tier-good { border-left: 4px solid #f59e0b; }
  .city-card.tier-ok { border-left: 4px solid var(--border); }

  .top-badge {
    position: absolute;
    top: -10px;
    right: 1rem;
    background: var(--accent);
    color: #fff;
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .city-head {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    margin-bottom: 0.7rem;
  }

  .city-rank {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--text);
    color: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 1.1rem;
  }

  .city-head h3 {
    font-size: 1.15rem;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .city-head h3 small {
    font-weight: 400;
    color: var(--text-tertiary);
    font-size: 0.85rem;
  }

  .city-tagline {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-top: 0.15rem;
  }

  .city-score {
    margin-left: auto;
    text-align: center;
    flex-shrink: 0;
  }

  .city-score-num {
    display: block;
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--text);
  }

  .city-score-label {
    font-size: 0.68rem;
    color: var(--text-tertiary);
  }

  .city-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.85rem;
  }

  .city-links {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .guide-link {
    font-size: 0.8rem;
    font-weight: 700;
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    text-decoration: none;
    background: rgba(37, 99, 235, 0.08);
    color: #1d4ed8;
  }

  /* ── Rest section ── */
  .rest-section {
    margin-top: 1rem;
    margin-bottom: 0.75rem;
  }

  .rest-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .rest-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 0.85rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
    text-decoration: none;
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.15s;
  }

  .rest-card:hover { border-color: var(--accent); text-decoration: none; }

  /* ── Related ── */
  .cl-related {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 1.2rem;
    margin-bottom: 0.75rem;
  }

  .cl-related h2 { font-size: 1.05rem; margin-bottom: 0.6rem; }

  .cl-related ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .cl-related a {
    display: inline-block;
    border-radius: 999px;
    padding: 0.45rem 0.75rem;
    background: var(--surface-hover);
    border: 1px solid var(--border);
    color: var(--text);
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
  }

  /* ── Explain grid ── */
  .explain-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }

  .info-card { padding: 1.35rem; }

  .info-card ul {
    padding-left: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .caution-card {
    background: linear-gradient(135deg, var(--orange-light), var(--surface));
  }

  @media (max-width: 860px) {
    .hero-panel, .tool-grid, .explain-grid {
      grid-template-columns: 1fr;
    }
    .hero-copy { padding: 1.35rem; }
    .checker-card { position: static; }
    .city-meta { grid-template-columns: 1fr; }
    .rest-list { grid-template-columns: 1fr; }
  }
</style>
