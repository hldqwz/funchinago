---
// src/pages/zh/compare.astro — 模型对比（中文版）
import Layout from "../../layouts/Layout.astro";
import { useTranslations } from "../../i18n";
import type { ModelData } from "../../types";

let models: ModelData[] = [];
try {
  const raw = await import("../../data/models.json");
  models = (raw.default?.models || raw.models || []).sort(
    (a: ModelData, b: ModelData) => (a.platforms?.openrouter?.rank || 999) - (b.platforms?.openrouter?.rank || 999)
  );
} catch {}

const locale = "zh";
const t = useTranslations(locale);

function priceOR(m: ModelData, s: "prompt" | "completion"): number | null {
  const p = m.platforms?.openrouter?.pricing; if (!p) return null;
  return parseFloat(p[s] || "0") * 1_000_000;
}
function priceGR(m: ModelData, s: "prompt" | "completion"): number | null {
  const p = m.platforms?.groq?.pricing; if (!p) return null;
  return s === "prompt" ? p.prompt_per_m ?? 0 : p.completion_per_m ?? 0;
}
function priceSF(m: ModelData, s: "prompt" | "completion"): number | null {
  const p = m.platforms?.siliconflow?.pricing; if (!p) return null;
  return s === "prompt" ? p.prompt_per_m ?? 0 : p.completion_per_m ?? 0;
}
function contextK(m: ModelData): number {
  return Math.round((m.platforms?.openrouter?.context_length || m.platforms?.groq?.context_length || m.platforms?.siliconflow?.context_length || 0) / 1024);
}
function cheapestRoundtrip(m: ModelData): number | null {
  const prices = [priceOR(m, "prompt"), priceGR(m, "prompt"), priceSF(m, "prompt")].filter(p => p !== null) as number[];
  const out = [priceOR(m, "completion"), priceGR(m, "completion"), priceSF(m, "completion")].filter(p => p !== null) as number[];
  if (prices.length === 0 || out.length === 0) return null;
  return Math.min(...prices) + Math.min(...out);
}


function getBestIn(m, selected, t) {
  const total = cheapestRoundtrip(m);
  const isCheapest = total !== null && selected.filter(s => s.canonical_name !== m.canonical_name).every(s => {
    const t = cheapestRoundtrip(s); return t === null || total <= t;
  });
  const isBigCtx = selected.filter(s => s.canonical_name !== m.canonical_name).every(s => contextK(m) >= contextK(s));
  const badges = [];
  if (isCheapest) badges.push(t("compare.best_value"));
  if (isBigCtx) badges.push(t("compare.best_context"));
  return badges;
}

function bestInBadges(m, selected, t) {
  return getBestIn(m, selected, t).map(b => `<span class="badge badge-green" style="margin:0.1rem">${b}</span>`).join("") || "—";
}

const idsParam = Astro.url.searchParams.get("ids") || "";
const selectedIds = idsParam ? idsParam.split(",") : [];
const selected = selectedIds.length > 0
  ? models.filter((m) => selectedIds.includes(m.canonical_name))
  : models.slice(0, 3);
---

<Layout title={t("compare.title")} description={t("compare.subtitle")} lang="zh">
  <div class="container" style="padding-top:2.5rem;">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
      <div><h1 style="font-size:1.75rem;font-weight:800;letter-spacing:-0.03em;">{t("compare.title")}</h1><p style="color:var(--text-secondary);margin-top:0.4rem;">{t("compare.subtitle")}</p></div>
      <a href="/zh/" class="btn btn-outline" style="font-size:0.85rem;">← {t("compare.back")}</a>
    </div>
    <div class="card" style="padding:1.25rem;margin-bottom:1.5rem;">
      <form method="get" action="/zh/compare">
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
          <div class="compare-select-wrap">
            <label style="font-size:0.85rem;font-weight:600;color:var(--text-secondary);display:block;margin-bottom:0.4rem;">{t("compare.select_hint")}</label>
            <select name="ids" multiple class="compare-select">
              {models.map(m => <option value={m.canonical_name} selected={selected.some(s => s.canonical_name === m.canonical_name)}>#{m.platforms?.openrouter?.rank} — {m.name}  (${cheapestRoundtrip(m) !== null ? cheapestRoundtrip(m)!.toFixed(1) : "—"}/M)</option>)}
            </select>
          </div>
          <div style="display:flex;align-items:flex-end;"><button type="submit" class="btn btn-primary">{t("compare.title")}</button></div>
        </div>
      </form>
    </div>

    {selected.length === 0 ? (
      <div class="card" style="text-align:center;padding:3rem;color:var(--text-secondary);">{t("compare.no_selection")}</div>
    ) : (
      <div class="card table-wrap"><table>
        <thead><tr><th class="compare-metric-col">{t("compare.col_metric")}</th>{selected.map(m => <th style="text-align:center;" colspan="2"><a href={`/zh/models/${m.canonical_name}`} style="color:var(--accent);font-size:0.9rem;">#{m.platforms?.openrouter?.rank} {m.name}</a></th>)}</tr></thead>
        <tbody>
          <tr><td style="color:var(--text-secondary);font-weight:500;">排名</td>{selected.map(m => <td colspan="2" style="text-align:center;font-weight:700;font-size:1.1rem;">#{m.platforms?.openrouter?.rank || "—"}</td>)}</tr>
          <tr><td style="color:var(--text-secondary);font-weight:500;">OR 输入价</td>{selected.map(m => { const p = priceOR(m, "prompt"); return <td colspan="2" style="text-align:center;font-weight:600;color:var(--green);">{p !== null ? `$${p.toFixed(2)}` : "—"}</td>; })}</tr>
          <tr><td style="color:var(--text-secondary);font-weight:500;">OR 输出价</td>{selected.map(m => { const p = priceOR(m, "completion"); return <td colspan="2" style="text-align:center;font-weight:600;color:var(--green);">{p !== null ? `$${p.toFixed(2)}` : "—"}</td>; })}</tr>
          {selected.some(m => priceGR(m, "prompt") !== null) && <tr><td style="color:var(--text-secondary);font-weight:500;">GR 输入价</td>{selected.map(m => { const p = priceGR(m, "prompt"); return <td colspan="2" style="text-align:center;font-weight:600;color:var(--accent-2);">{p !== null ? `$${p.toFixed(2)}` : <span style="color:var(--text-tertiary);">—</span>}</td>; })}</tr>}
          {selected.some(m => priceSF(m, "prompt") !== null) && <tr><td style="color:var(--text-secondary);font-weight:500;">SF 输入价</td>{selected.map(m => { const p = priceSF(m, "prompt"); return <td colspan="2" style="text-align:center;font-weight:600;color:var(--orange);">{p !== null ? `$${p.toFixed(2)}` : <span style="color:var(--text-tertiary);">—</span>}</td>; })}</tr>}
          <tr><td style="color:var(--text-secondary);font-weight:500;">最佳往返价</td>{selected.map(m => { const p = cheapestRoundtrip(m); return <td colspan="2" style="text-align:center;font-weight:700;color:var(--accent);font-size:1.05rem;">{p !== null ? `$${p.toFixed(2)}/M` : "—"}</td>; })}</tr>
          <tr><td style="color:var(--text-secondary);font-weight:500;">上下文</td>{selected.map(m => <td colspan="2" style="text-align:center;font-weight:600;">{contextK(m).toLocaleString()}K</td>)}</tr>
          <tr><td style="color:var(--text-secondary);font-weight:500;">可用平台</td>{selected.map(m => { const ps = Object.keys(m.platforms || {}); return <td colspan="2" style="text-align:center;">{ps.map(p => <span class={`badge badge-platform ${p === "openrouter" ? "badge-blue" : p === "groq" ? "badge-purple" : p === "bailian" ? "badge-teal" : "badge-orange"}`} style="margin:0.1rem;">{p === "openrouter" ? "OR" : p === "groq" ? "GR" : p === "bailian" ? "BL" : "SF"}</span>)}</td>; })}</tr>
          <tr><td style="color:var(--text-secondary);font-weight:500;">称号</td>{selected.map(m => <td colspan="2" style="text-align:center;">{bestInBadges(m, selected, t).length > 0 ? <Fragment set:html={bestInBadges(m, selected, t)} /> : <span style="color:var(--text-tertiary);font-size:0.8rem;">—</span>}</td>)}</tr>
        </tbody>
      </table></div>
    )}
  </div>
</Layout>

<style>
  .compare-select-wrap {
    flex: 1;
    min-width: 280px;
  }
  .compare-select {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.9rem;
    min-height: 200px;
  }
  .compare-metric-col {
    width: 100px;
  }

  @media (max-width: 768px) {
    .compare-select-wrap {
      min-width: 200px;
    }
    .compare-select {
      min-height: 140px;
    }
    .compare-metric-col {
      width: 70px;
    }
  }
</style>
