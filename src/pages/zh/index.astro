---
// src/pages/zh/index.astro — 排行榜首页（中文版）
import Layout from "../../layouts/Layout.astro";
import { useTranslations } from "../../i18n";
import type { ModelData } from "../../types";

const locale = "zh";
const t = useTranslations(locale);

let models: ModelData[] = [];
let updatedAt = "";
let platformStats = { openrouter: 0, groq: 0, siliconflow: 0, bailian: 0, multi_platform: 0 };

try {
  const raw = await import("../../data/models.json");
  if (raw.default && raw.default.models) {
    models = raw.default.models;
    updatedAt = raw.default.updated_at || "";
    platformStats = raw.default.platform_stats || platformStats;
  }
} catch {}

function priceOR(model: ModelData, side: "prompt" | "completion"): number {
  const p = model.platforms?.openrouter?.pricing;
  if (!p) return -1;
  return parseFloat(p[side] || "0") * 1_000_000;
}
function priceGR(model: ModelData, side: "prompt" | "completion"): number {
  const p = model.platforms?.groq?.pricing;
  if (!p) return -1;
  if (side === "prompt") return p.prompt_per_m ?? parseFloat(p.prompt || "0");
  return p.completion_per_m ?? parseFloat(p.completion || "0");
}
function priceSF(model: ModelData, side: "prompt" | "completion"): number {
  const p = model.platforms?.siliconflow?.pricing;
  if (!p) return -1;
  if (side === "prompt") return p.prompt_per_m ?? (parseFloat(p.prompt || "0") * 1_000_000);
  return p.completion_per_m ?? (parseFloat(p.completion || "0") * 1_000_000);
}
function getMinInputPrice(model: ModelData): number | null {
  const prices = [priceOR(model, "prompt"), priceGR(model, "prompt"), priceSF(model, "prompt")].filter(p => p >= 0);
  return prices.length > 0 ? Math.min(...prices) : null;
}
function getMinOutputPrice(model: ModelData): number | null {
  const prices = [priceOR(model, "completion"), priceGR(model, "completion"), priceSF(model, "completion")].filter(p => p >= 0);
  return prices.length > 0 ? Math.min(...prices) : null;
}
function getPlatforms(model: ModelData): string[] { return Object.keys(model.platforms || {}); }
function getUsage(model: ModelData): number | null { return model.platforms?.openrouter?.usage_tokens ?? null; }
function getTrend(model: ModelData): string { return model.platforms?.openrouter?.trend || ""; }
function getRank(model: ModelData): number | null { return model.platforms?.openrouter?.rank ?? null; }
function usageDisplay(n: number | null): string {
  if (!n) return "—";
  if (n >= 1e12) return (n / 1e12).toFixed(1) + "T";
  if (n >= 1e9) return (n / 1e9).toFixed(1) + "B";
  if (n >= 1e6) return (n / 1e6).toFixed(1) + "M";
  if (n >= 1e3) return (n / 1e3).toFixed(0) + "K"; return n.toString();
}
function contextK(model: ModelData): number {
  return Math.round((model.platforms?.openrouter?.context_length || model.platforms?.groq?.context_length || model.platforms?.siliconflow?.context_length || model.platforms?.bailian?.context_length || 0) / 1024);
}
function getRoundtrip(model: ModelData): number | null {
  const in_ = priceOR(model, "prompt"); const out_ = priceOR(model, "completion");
  if (in_ < 0 || out_ < 0) return null; return in_ + out_;
}

const rankedModels = models.filter(m => getPlatforms(m).includes("openrouter") && getRank(m)).sort((a, b) => (getRank(a) || 999) - (getRank(b) || 999));
const unrankedModels = models.filter(m => !getRank(m));
const topMostUsed = [...rankedModels].sort((a, b) => (getUsage(b) || 0) - (getUsage(a) || 0)).slice(0, 5);
const topValue = [...rankedModels].filter(m => getRoundtrip(m) !== null).sort((a, b) => (getRoundtrip(a) || Infinity) - (getRoundtrip(b) || Infinity)).slice(0, 5);
const topTrending = [...rankedModels].filter(m => { const t = getTrend(m); const n = parseFloat(t.replace(/[^0-9.\-]/g, "")); return !isNaN(n) && n > 0; }).sort((a, b) => parseFloat(getTrend(b).replace(/[^0-9.\-]/g, "0")) - parseFloat(getTrend(a).replace(/[^0-9.\-]/g, "0"))).slice(0, 5);
const topCtx = [...models].filter(m => contextK(m) > 0).sort((a, b) => contextK(b) - contextK(a)).slice(0, 5);
const maxUsage = topMostUsed.length > 0 ? getUsage(topMostUsed[0]) || 1 : 1;
const maxTrend = topTrending.length > 0 ? parseFloat(getTrend(topTrending[0]).replace(/[^0-9.\-]/g, "0")) || 1 : 1;
const maxCtx = topCtx.length > 0 ? contextK(topCtx[0]) || 1 : 1;

function platformColor(p: string): string { return p === "openrouter" ? "badge-blue" : p === "groq" ? "badge-purple" : p === "bailian" ? "badge-teal" : "badge-orange"; }
function rankClass(r: number | null): string { if (r === 1) return "gold"; if (r === 2) return "silver"; if (r === 3) return "bronze"; return ""; }
---

<Layout title={t("site.title")} description={t("site.description")} lang="zh">
  <div class="container" style="padding-top: 2rem;">
    <div style="display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.5rem;">
      <div>
        <h1 style="font-size: 1.65rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1.25;">{t("home.hero_title")}</h1>
        <p style="color: var(--text-secondary); margin-top: 0.3rem; font-size: 0.9rem;">
          {t("home.hero_subtitle")}
          {updatedAt && <> · {t("site.updated")} {new Date(updatedAt).toLocaleString("zh-CN", { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" })}</>}
        </p>
      </div>
      <div style="display: flex; gap: 0.4rem;">
        <span class="badge badge-blue">🏆 {platformStats.openrouter} {t("home.stat_ranked")}</span>
        <span class="badge badge-purple">{t("home.stat_collected")} {models.length}</span>
      </div>
    </div>

    <div class="stat-grid" style="margin-bottom: 2rem;">
      <div class="stat-tile"><div class="stat-value" style="color: var(--accent);">{models.length}</div><div class="stat-label">{t("home.stat_collected")}</div></div>
      <div class="stat-tile"><div class="stat-value" style="color: var(--green);">{rankedModels.length}</div><div class="stat-label">{t("home.stat_ranked")}</div></div>
      <div class="stat-tile"><div class="stat-value" style="color: var(--accent-2);">{[platformStats.openrouter > 0, platformStats.groq > 0, platformStats.siliconflow > 0, platformStats.bailian > 0].filter(Boolean).length}</div><div class="stat-label">{t("home.stat_platforms")}</div></div>
      <div class="stat-tile"><div class="stat-value" style="color: var(--gold); font-size: 1.3rem;">{topCtx.length > 0 ? `${contextK(topCtx[0]).toLocaleString()}K` : "—"}</div><div class="stat-label">{t("home.stat_context")}</div></div>
    </div>

    <!-- Leader Cards -->
    <div class="leader-grid">
      <div class="leader-card"><h3>📊 {t("home.section_most_used")}</h3>
        {topMostUsed.map((m, i) => { const u = getUsage(m); const pct = u ? Math.max(3, (u / Number(maxUsage)) * 100) : 5;
          return <div class="leader-row"><span class="leader-num">{i + 1}</span><a href={`/zh/models/${m.canonical_name}`} class="leader-name">{m.name}</a><div class="leader-bar"><div class="bar-fill bar-blue" style={`width:${pct}%`}></div></div></div><span class="leader-score">{usageDisplay(u)}</span></div>; })}
      </div>
      <div class="leader-card"><h3>💰 {t("home.section_best_value")}</h3>
        {topValue.map((m, i) => { const p = getRoundtrip(m) || 0; const maxP = getRoundtrip(topValue[topValue.length - 1]) || 1; const pct = Math.max(3, (1 - p / maxP) * 100);
          return <div class="leader-row"><span class="leader-num">{i + 1}</span><a href={`/zh/models/${m.canonical_name}`} class="leader-name">{m.name}</a><div class="leader-bar"><div class="bar-fill bar-green" style={`width:${pct}%`}></div></div></div><span class="leader-score">${p.toFixed(2)}</span></div>; })}
      </div>
      <div class="leader-card"><h3>🔥 {t("home.section_trending")}</h3>
        {topTrending.map((m, i) => { const tr = getTrend(m); const num = parseFloat(tr.replace(/[^0-9.\-]/g, "0")); const pct = Math.max(3, (num / maxTrend) * 100);
          return <div class="leader-row"><span class="leader-num">🔥</span><a href={`/zh/models/${m.canonical_name}`} class="leader-name">{m.name}</a><div class="leader-bar"><div class="bar-fill bar-gold" style={`width:${pct}%`}></div></div></div><span class="leader-score">↑{tr}</span></div>; })}
      </div>
      <div class="leader-card"><h3>📐 {t("home.section_longest_context")}</h3>
        {topCtx.map((m, i) => { const ctx = contextK(m); const pct = Math.max(3, (ctx / maxCtx) * 100);
          return <div class="leader-row"><span class="leader-num">{i + 1}</span><a href={`/zh/models/${m.canonical_name}`} class="leader-name">{m.name}</a><div class="leader-bar"><div class="bar-fill bar-purple" style={`width:${pct}%`}></div></div></div><span class="leader-score">{ctx.toLocaleString()}K</span></div>; })}
      </div>
    </div>

    <div class="search-wrap" style="margin-bottom: 1rem;">
      <span class="search-icon">🔍</span>
      <input id="model-search" class="search-input" type="text" placeholder={t("home.search_placeholder")} />
    </div>

    <div class="card table-wrap">
      <table>
        <thead><tr>
          <th style="width:40px;text-align:center;">{t("home.col_rank")}</th>
          <th>{t("home.col_model")}</th>
          <th style="text-align:right;">{t("home.col_input")}</th>
          <th style="text-align:right;">{t("home.col_output")}</th>
          <th style="text-align:center;">{t("home.col_platforms")}</th>
          <th style="text-align:right;">{t("home.col_context")}</th>
          <th style="text-align:right;">{t("home.col_usage")}</th>
          <th style="text-align:center;">{t("home.col_trend")}</th>
        </tr></thead>
        <tbody>
          {rankedModels.map((model) => {
            const r = getRank(model) || 0;
            const inP = getMinInputPrice(model);
            const outP = getMinOutputPrice(model);
            const platforms = getPlatforms(model);
            const ctx = contextK(model);
            return (
              <tr class="model-row" data-name={model.name} data-provider={""}>
                <td style="text-align:center;"><span class={"rank-num " + rankClass(r)}>{r}</span></td>
                <td>
                  <a href={`/zh/models/${model.canonical_name}`} style="font-weight:600;color:var(--text);">{model.name}</a>
                  {model.platforms?.openrouter?.top_provider?.name && <span class="badge badge-blue badge-platform" style="margin-left:0.4rem;">{model.platforms.openrouter.top_provider.name}</span>}
                </td>
                <td style="text-align:right;font-weight:600;">{inP !== null ? <span style={`color:${inP < 1 ? "var(--green)" : "var(--text)"}`}>${inP.toFixed(2)}</span> : <span style="color:var(--text-tertiary)">—</span>}</td>
                <td style="text-align:right;font-weight:600;">{outP !== null ? <span style={`color:${outP < 2 ? "var(--green)" : "var(--text)"}`}>${outP.toFixed(2)}</span> : <span style="color:var(--text-tertiary)">—</span>}</td>
                <td style="text-align:center;"><div style="display:flex;gap:0.2rem;justify-content:center;">{platforms.map(p => <span class={"badge badge-platform " + platformColor(p)}>{p === "openrouter" ? "OR" : p === "groq" ? "GR" : p === "bailian" ? "BL" : "SF"}</span>)}</div></td>
                <td style="text-align:right;color:var(--text-secondary);font-size:0.82rem;">{ctx > 0 ? `${ctx.toLocaleString()}K` : "—"}</td>
                <td style="text-align:right;font-weight:600;">{usageDisplay(getUsage(model))}</td>
                <td style="text-align:center;">{getTrend(model) && getTrend(model) !== "0%" ? <span class={`badge ${getTrend(model).startsWith("-") ? "badge-red" : "badge-green"}`}>{getTrend(model).startsWith("-") ? "↓" : "↑"} {getTrend(model)}</span> : <span style="color:var(--text-tertiary);font-size:0.75rem;">—</span>}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    {unrankedModels.length > 0 && (
      <details style="margin-top:1.5rem;">
        <summary style="cursor:pointer;color:var(--text-secondary);font-size:0.85rem;padding:0.5rem 0;">{unrankedModels.length} {t("home.unranked_title")}</summary>
        <div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-top:0.5rem;">
          {unrankedModels.slice(0,60).map(m => <a href={`/zh/models/${m.canonical_name}`} class="badge badge-blue">{m.name}</a>)}
          {unrankedModels.length > 60 && <span style="color:var(--text-tertiary);font-size:0.8rem;padding:0.2rem 0.5rem;">{t("home.unranked_count").replace("{count}", String(unrankedModels.length - 60))}</span>}
        </div>
      </details>
    )}
  </div>
</Layout>

<style>
  .leader-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .leader-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
