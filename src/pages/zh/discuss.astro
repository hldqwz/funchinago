---
// src/pages/zh/discuss.astro
import Layout from "../../layouts/Layout.astro";
import { useTranslations } from "../../i18n";
import GiscusComments from "../../components/GiscusComments.astro";

const locale = "zh";
const t = useTranslations(locale);
---

<Layout title="讨论区" lang={locale}>
  <div class="container-narrow" style="padding-top: 2rem; padding-bottom: 3rem;">
    <h1 style="font-size: 1.65rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.5rem;">
      讨论区
    </h1>
    <p style="color: var(--text-secondary); margin-bottom: 2rem;">
      聊模型、分享使用经验、提问交流——关于大模型选择和使用的任何话题。
    </p>

    <GiscusComments mapping="Discussion Board" />
  </div>
</Layout>
