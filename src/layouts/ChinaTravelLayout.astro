---
import "../styles/tokens.css";
import "../styles/base.css";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  pageType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { title, description, ogImage, pageType = "website", jsonLd } = Astro.props;
const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ?? new URL("https://funchinago.com");
const canonicalUrl = new URL(currentPath, siteUrl);
const socialImageUrl = new URL(
  ogImage || "/china-travel/images/og-shanghai-bund-night.jpg",
  siteUrl
);

const lastVerified = "17 OCT 2026";

const sectionBreadcrumbMap: Record<string, { name: string }> = {
  "/china-travel/start-here/": { name: "Start Here" },
  "/china-travel/travel/": { name: "Travel" },
  "/china-travel/cities/": { name: "Cities" },
  "/china-travel/life-culture/": { name: "Life & Culture" },
  "/china-travel/tools/": { name: "Tools" },
  "/china-travel/sources/": { name: "Sources" },
  "/china-travel/articles/": { name: "Articles" },
};

const homeUrl = new URL("/china-travel/", siteUrl).toString();
const breadcrumbItems: Array<{ "@type": string; position: number; name: string; item?: string }> = [
  { "@type": "ListItem", position: 1, name: "Home", item: homeUrl },
];

const matchedSection = sectionBreadcrumbMap[currentPath];
if (matchedSection) {
  breadcrumbItems.push({
    "@type": "ListItem",
    position: 2,
    name: matchedSection.name,
    item: new URL(currentPath, siteUrl).toString(),
  });
} else if (currentPath.startsWith("/china-travel/articles/") && currentPath !== "/china-travel/articles/") {
  breadcrumbItems.push({
    "@type": "ListItem",
    position: 2,
    name: "Articles",
    item: new URL("/china-travel/articles/", siteUrl).toString(),
  });
  breadcrumbItems.push({ "@type": "ListItem", position: 3, name: title });
} else if (currentPath.startsWith("/tools/")) {
  breadcrumbItems.push({
    "@type": "ListItem",
    position: 2,
    name: "Tools",
    item: new URL("/china-travel/tools/", siteUrl).toString(),
  });
  breadcrumbItems.push({ "@type": "ListItem", position: 3, name: title });
}

const methodologyUrl = new URL("/china-travel/methodology/", siteUrl).toString();

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": new URL("/china-travel/", siteUrl).toString(),
  "name": "China Travel Made Easy",
  "url": new URL("/china-travel/", siteUrl).toString(),
  "logo": new URL("/images/logo.svg", siteUrl).toString(),
  "image": new URL("/images/logo.svg", siteUrl).toString(),
  "description": "Practical China travel guides for international first-time visitors, anchored by official sources.",
  "foundingDate": "2025",
  "publishingPrinciples": methodologyUrl,
  "ethicsPolicy": methodologyUrl,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems,
};

const defaultSchemas: Array<Record<string, unknown>> = [orgSchema, breadcrumbSchema];
const extraSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allSchemas = [...defaultSchemas, ...extraSchemas];

const navItems = [
  { href: "/china-travel/", label: "Home", match: (path: string) => path === "/china-travel/" },
  { href: "/china-travel/start-here/", label: "Start Here", match: (path: string) => path.includes("/china-travel/start-here/") },
  { href: "/china-travel/cities/", label: "Cities", match: (path: string) => path.includes("/china-travel/cities/") },
  { href: "/china-travel/tools/", label: "Tools", match: (path: string) => path.includes("/china-travel/tools/") || path.includes("/tools/china-") },
  { href: "/china-travel/sources/", label: "Sources", match: (path: string) => path.includes("/china-travel/sources/") },
];

const footerExplore = [
  { label: "Start Here", href: "/china-travel/start-here/" },
  { label: "Travel", href: "/china-travel/travel/" },
  { label: "Payment", href: "/china-travel/travel/#payments" },
  { label: "Transport", href: "/china-travel/travel/#trains-routes" },
  { label: "Apps & VPN", href: "/china-travel/travel/#internet-apps" },
  { label: "Life & Culture", href: "/china-travel/life-culture/" },
  { label: "Articles", href: "/china-travel/articles/" },
];

const footerCities = ["Beijing", "Shanghai", "Xi'an", "Chengdu", "Zhuhai"];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description || "Practical China travel guides for international first-time visitors."} />
  <meta name="robots" content="index,follow" />
  <link rel="canonical" href={canonicalUrl.toString()} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description || "Practical China travel guides for international first-time visitors."} />
  <meta property="og:type" content={pageType} />
  <meta property="og:url" content={canonicalUrl.toString()} />
  <meta property="og:image" content={socialImageUrl.toString()} />
  <meta property="og:site_name" content="China Travel Made Easy" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description || "Practical China travel guides for international first-time visitors."} />
  <meta name="twitter:image" content={socialImageUrl.toString()} />
  <meta name="theme-color" content="#b23a2b" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23b23a2b'/%3E%3Ccircle cx='16' cy='16' r='8.5' fill='none' stroke='%23f7f4ec' stroke-width='1.8'/%3E%3Cpath d='M16 7.4 18.7 16 16 24.6 13.3 16Z' fill='%23f7f4ec'/%3E%3C/svg%3E" />
  <!-- Cloudflare Web Analytics -->
      <link rel="preload" href="/fonts/newsreader-500.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/source-sans-3-400.woff2" as="font" type="font/woff2" crossorigin>
<script>document.documentElement.classList.add("js");</script>
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "53776ca23b6448c6a4527a04a6b1b66a"}'></script>

  {allSchemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  ))}

  <style is:global>
    html {
      background: var(--paper);
    }

    body {
      background: var(--paper);
      color: var(--ink);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      transition: background-color var(--dur-base) ease, color var(--dur-base) ease;
      min-height: 100vh;
    }

    .container { max-width: var(--measure-wide); margin: 0 auto; padding: 0 1.5rem; }
    .container-narrow { max-width: 900px; margin: 0 auto; padding: 0 1.5rem; }

    .site-shell {
      position: relative;
    }

    /* ---- 顶栏 utility strip ---- */
    .utility-strip {
      border-bottom: 1px solid var(--hairline);
      background: var(--paper-dim);
      color: var(--ink-45);
    }

    .utility-strip .container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .utility-meta {
      display: inline-flex;
      align-items: center;
      text-transform: uppercase;
      color: var(--celadon);
    }

    .utility-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* ---- header ---- */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      padding: 0.85rem 0;
      background: var(--header-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid transparent;
      transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
    }

    .site-header.is-scrolled {
      background-color: rgba(247, 244, 236, 0.96);
      border-bottom-color: var(--hairline);
    }

    [data-theme="dark"] .site-header.is-scrolled {
      background-color: rgba(18, 24, 22, 0.96);
    }

    .site-header .container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .brand-lockup {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      min-width: 0;
      flex: 0 1 auto;
    }

    .brand-mark {
      width: 2.7rem;
      height: 2.7rem;
      border-radius: var(--r-media);
      display: grid;
      place-items: center;
      background: var(--surface);
      border: 1px solid var(--hairline);
      color: var(--seal);
      font-size: 1.2rem;
      flex-shrink: 0;
    }

    .logo {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      min-width: 0;
      color: var(--ink);
      text-decoration: none;
    }

    .logo:hover {
      text-decoration: none;
    }

    .logo-eyebrow {
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--celadon);
    }

    .logo-title {
      font-family: var(--font-display);
      font-size: 1.3rem;
      font-weight: 600;
      line-height: 1.15;
      letter-spacing: 0;
      color: var(--ink);
    }

    .logo-subtitle {
      font-size: var(--fs-sm);
      font-weight: 400;
      color: var(--ink-70);
      line-height: 1.3;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      flex: 1 1 auto;
      justify-content: flex-end;
      min-width: 0;
    }

    .site-nav {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 0.25rem;
      flex-wrap: wrap;
      min-width: 0;
    }

    .site-nav a {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 0.5rem 0.7rem;
      border: 0;
      border-radius: var(--r-sm);
      font-size: var(--fs-sm);
      font-weight: 600;
      color: var(--ink-70);
      white-space: nowrap;
      transition: color var(--dur-fast) var(--ease-out);
    }

    .site-nav a::after {
      content: "";
      position: absolute;
      left: 0.7rem;
      right: 0.7rem;
      bottom: 0.55rem;
      height: 1px;
      background: currentColor;
      opacity: 0;
      transition: opacity var(--dur-fast) var(--ease-out);
    }

    .site-nav a:hover {
      color: var(--ink);
      text-decoration: none;
    }

    .site-nav a:hover::after {
      opacity: 1;
    }

    .site-nav a.active {
      color: var(--seal);
    }

    .site-nav a.active::after {
      opacity: 1;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-shrink: 0;
    }

    .theme-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      min-height: 44px;
      padding: 0 0.7rem;
      border-radius: var(--r-sm);
      font-family: var(--font-mono);
      font-size: var(--fs-mono);
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--ink-70);
      border: 1px solid var(--hairline);
      background: transparent;
      transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
      cursor: pointer;
    }

    .theme-toggle:hover {
      border-color: var(--seal);
      color: var(--seal);
    }

    .theme-icon {
      flex-shrink: 0;
    }

    .theme-icon-sun {
      display: none;
    }

    html[data-theme="dark"] .theme-icon-moon {
      display: none;
    }

    html[data-theme="dark"] .theme-icon-sun {
      display: block;
    }

    .nav-toggle {
      display: none;
      align-items: center;
      gap: 0.45rem;
      min-height: 44px;
      padding: 0 0.75rem;
      border-radius: var(--r-sm);
      border: 1px solid var(--hairline);
      background: transparent;
      color: var(--ink-70);
      font-family: var(--font-mono);
      font-size: var(--fs-mono);
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      cursor: pointer;
      transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
    }

    .nav-toggle:hover {
      border-color: var(--seal);
      color: var(--seal);
    }

    .nav-toggle-bars {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      gap: 3px;
      width: 16px;
      height: 16px;
    }

    .nav-toggle-bars span {
      display: block;
      height: 1.5px;
      background: currentColor;
    }

    main {
      display: block;
    }

    /* ---- footer ---- */
    .site-footer {
      margin-top: var(--space-tight);
      padding: var(--space-tight) 0 0;
      border-top: 1px solid var(--hairline);
      background: var(--paper-dim);
      color: var(--ink-70);
      transition: border-color var(--dur-base) ease, background-color var(--dur-base) ease;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 4fr 3fr 3fr 2fr;
      gap: var(--grid-gap-lg);
      padding-bottom: var(--space-tight);
    }

    .footer-col {
      min-width: 0;
    }

    .footer-heading {
      margin: 0 0 0.35rem;
      font-family: var(--font-mono);
      font-size: var(--fs-meta);
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink);
    }

    .footer-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .footer-list a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      font-size: var(--fs-sm);
      font-weight: 400;
      color: var(--ink-70);
      transition: color var(--dur-fast) var(--ease-out);
    }

    .footer-list a:hover {
      color: var(--seal);
      text-decoration: none;
    }

    .footer-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
      padding: 1rem 0;
      border-top: 1px solid var(--hairline);
      color: var(--ink-45);
      text-transform: uppercase;
    }

    .footer-bar p {
      margin: 0;
    }

    /* ---- shared bits used by article / section pages ---- */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      min-height: 44px;
      padding: 0.5rem 1rem;
      border-radius: var(--r-pill);
      font-size: var(--fs-sm);
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: background-color var(--dur-fast) ease, color var(--dur-fast) ease;
    }

    .btn-primary { background: var(--seal); color: var(--paper); }
    .btn-primary:hover { background: var(--seal-deep); }

    select {
      min-height: 44px;
      background: var(--search-bg);
      color: var(--ink);
      border: 1px solid var(--hairline);
      border-radius: var(--r-sm);
    }

    select:focus { border-color: var(--seal); box-shadow: 0 0 0 3px var(--seal-tint); }
    option { background: var(--surface); color: var(--ink); }

    .payment-steps {
      counter-reset: payment-step;
      display: grid;
      gap: 0.8rem;
      list-style: none;
      padding: 0 !important;
    }

    .payment-steps li {
      counter-increment: payment-step;
      position: relative;
      min-height: 3rem;
      margin: 0 !important;
      padding: 0.85rem 1rem 0.85rem 3.75rem;
      border: 1px solid var(--hairline);
      border-radius: var(--r-sm);
      background: var(--surface);
    }

    .payment-steps li::before {
      content: counter(payment-step);
      position: absolute;
      top: 0.75rem;
      left: 0.85rem;
      display: grid;
      width: 2rem;
      height: 2rem;
      place-items: center;
      border-radius: var(--r-pill);
      background: var(--seal);
      color: var(--paper);
      font-weight: 700;
    }

    .payment-flow {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.8rem;
      margin: 1rem 0 1.4rem;
    }

    .payment-flow section {
      padding: 1rem;
      border: 1px solid var(--hairline);
      border-radius: var(--r-sm);
      background: var(--surface);
    }

    .payment-flow h3 { margin-top: 0 !important; }
    .payment-flow p:last-child { margin-bottom: 0 !important; }

    .payment-table {
      width: 100%;
      margin: 1rem 0 1.4rem;
      border-collapse: collapse;
      border: 1px solid var(--hairline);
      background: var(--surface);
      font-size: var(--fs-sm);
    }

    .payment-table th,
    .payment-table td {
      padding: 0.75rem;
      border: 1px solid var(--hairline);
      text-align: left;
      vertical-align: top;
    }

    .payment-table th {
      background: var(--seal-tint);
      color: var(--ink);
      font-weight: 700;
    }

    .trust-module {
      margin: 1.25rem 0;
      padding: 1rem 1.1rem;
      border: 1px solid var(--hairline);
      border-left: 4px solid var(--seal);
      border-radius: var(--r-sm);
      background: var(--seal-tint);
      color: var(--ink-70);
    }

    .trust-module strong { color: var(--ink); }
    .trust-module p { margin: 0.35rem 0 0 !important; }

    /* ---- 保留的高亮块（去掉光斑装饰，仅留左侧色条） ---- */
    .feature-accent {
      position: relative;
      background: var(--feature-accent-bg);
      border: 1px solid var(--hairline);
      border-radius: var(--r-media);
    }

    .feature-accent::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: 4px;
      background: var(--feature-accent-line);
    }

    .feature-accent > * {
      position: relative;
      z-index: 1;
    }

    @media (max-width: 960px) {
      .nav-toggle {
        display: inline-flex;
      }

      .site-header .container {
        flex-wrap: wrap;
      }

      .header-right {
        display: none;
        width: 100%;
        flex-direction: column;
        align-items: stretch;
        gap: 0.5rem;
        padding-top: 0.5rem;
      }

      .header-right.is-open {
        display: flex;
      }

      .site-nav {
        flex-direction: column;
        align-items: stretch;
        justify-content: flex-start;
      }

      .site-nav a {
        justify-content: flex-start;
        padding-left: 0;
        padding-right: 0;
      }

      .site-nav a::after {
        left: 0;
        right: auto;
        width: 1.5rem;
      }

      .header-actions {
        justify-content: flex-start;
      }

      .footer-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 640px) {
      .container, .container-narrow { padding: 0 1rem; }

      .site-header {
        padding: 0.75rem 0;
      }

      .brand-lockup {
        align-items: flex-start;
      }

      .brand-mark {
        width: 2.45rem;
        height: 2.45rem;
      }

      .logo-title {
        font-size: 1.15rem;
      }

      .logo-subtitle {
        font-size: 0.8rem;
      }

      .footer-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: var(--grid-gap);
      }

      .site-footer {
        margin-top: var(--space-tight);
      }

      .payment-flow { grid-template-columns: 1fr; }

      .payment-table {
        display: block;
        overflow-x: auto;
        white-space: normal;
      }
    }
  </style>
</head>
<body>
  <div class="site-shell">
    <div class="utility-strip">
      <div class="container">
        <p class="mono-meta utility-meta"><span class="verified-dot">VERIFIED · {lastVerified}</span></p>
        <div class="utility-actions">
          <button
            id="theme-btn"
            class="theme-toggle"
            type="button"
            aria-label="Dark theme"
            aria-pressed="false"
          >
            <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" />
            </svg>
            <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
            </svg>
            <span class="theme-label">Dark</span>
          </button>
        </div>
      </div>
    </div>

    <header class="site-header">
      <div class="container">
        <div class="brand-lockup">
          <div class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" />
              <path d="M14.8 9.2 13.4 13.4 9.2 14.8 10.6 10.6Z" />
            </svg>
          </div>
          <a href="/china-travel/" class="logo">
            <span class="logo-eyebrow">FunChinaGo</span>
            <span class="logo-title">China Travel Made Easy</span>
            <span class="logo-subtitle">A calm, practical starting point for international first-time visitors.</span>
          </a>
        </div>

        <button
          id="nav-toggle"
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="primary-nav"
          aria-label="Open navigation menu"
        >
          <span class="nav-toggle-bars" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span class="nav-toggle-text">Menu</span>
        </button>

        <div class="header-right" id="primary-nav">
          <nav class="site-nav" aria-label="Primary">
            {navItems.map((item) => (
              <a href={item.href} class:list={{ active: item.match(currentPath) }} aria-current={item.match(currentPath) ? "page" : undefined}>
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-col">
            <h2 class="footer-heading">Trust &amp; Verify</h2>
            <ul class="footer-list">
              <li><a href="/china-travel/methodology/">How we verify</a></li>
              <li><a href="/china-travel/sources/">Source Library</a></li>
              <li><a href="/china-travel/methodology/#verification-log">Verification log</a></li>
              <li><a href="/china-travel/corrections/">Report a correction</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h2 class="footer-heading">Explore</h2>
            <ul class="footer-list">
              {footerExplore.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </div>

          <div class="footer-col">
            <h2 class="footer-heading">Cities</h2>
            <ul class="footer-list">
              {footerCities.map((city) => (
                <li><a href="/china-travel/cities/">{city}</a></li>
              ))}
            </ul>
          </div>

          <div class="footer-col">
            <h2 class="footer-heading">Site</h2>
            <ul class="footer-list">
              <li><a href="/china-travel/about/">About</a></li>
              <li><a href="/china-travel/contact/">Contact</a></li>
              <li><a href="/china-travel/articles/">Articles</a></li>
              <li><a href="/china-travel/tools/">Tools</a></li>
              <li><a href="/china-travel/sources/">Sources</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bar mono-meta">
          <p>© 2026 FunChinaGo</p>
          <p>Last verified {lastVerified}</p>
        </div>
      </div>
    </footer>
  </div>

  <script>
    (function () {
      /* ---------------- 主题切换 ---------------- */
      const btn = document.getElementById("theme-btn");
      const label = btn && btn.querySelector(".theme-label");

      const STORAGE_KEY = "china-travel-theme";
      const DARK = "dark";
      const LIGHT = "light";

      function getPreferredTheme() {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored === DARK || stored === LIGHT) return stored;
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? DARK : LIGHT;
      }

      function applyTheme(theme) {
        const isDark = theme === DARK;
        if (isDark) {
          document.documentElement.setAttribute("data-theme", DARK);
        } else {
          document.documentElement.removeAttribute("data-theme");
        }
        if (btn) {
          btn.setAttribute("aria-pressed", String(isDark));
          btn.setAttribute("aria-label", isDark ? "Dark theme" : "Light theme");
        }
        if (label) {
          label.textContent = isDark ? "Dark" : "Light";
        }
      }

      if (btn) {
        applyTheme(getPreferredTheme());

        btn.addEventListener("click", () => {
          const current =
            document.documentElement.getAttribute("data-theme") === DARK ? DARK : LIGHT;
          const next = current === DARK ? LIGHT : DARK;
          localStorage.setItem(STORAGE_KEY, next);
          applyTheme(next);
        });

        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (!localStorage.getItem(STORAGE_KEY)) {
            applyTheme(e.matches ? DARK : LIGHT);
          }
        });
      }

      /* ---------------- 移动端导航 ---------------- */
      const navToggle = document.getElementById("nav-toggle");
      const navPanel = document.getElementById("primary-nav");
      const navText = navToggle && navToggle.querySelector(".nav-toggle-text");

      function setNavOpen(open) {
        if (!navToggle || !navPanel) return;
        navPanel.classList.toggle("is-open", open);
        navToggle.setAttribute("aria-expanded", String(open));
        navToggle.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
        if (navText) navText.textContent = open ? "Close" : "Menu";
      }

      if (navToggle && navPanel) {
        navToggle.addEventListener("click", () => {
          setNavOpen(navToggle.getAttribute("aria-expanded") !== "true");
        });

        navPanel.addEventListener("click", (event) => {
          if (event.target instanceof Element && event.target.closest("a")) {
            setNavOpen(false);
          }
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") setNavOpen(false);
        });

        window.matchMedia("(min-width: 961px)").addEventListener("change", (e) => {
          if (e.matches) setNavOpen(false);
        });
      }

      /* ---------------- Header 滚动反馈（仅底色 / 边框，不改高度） ---------------- */
      const header = document.querySelector(".site-header");
      if (header) {
        let queued = false;
        const sync = () => {
          queued = false;
          header.classList.toggle("is-scrolled", window.scrollY > 24);
        };
        window.addEventListener(
          "scroll",
          () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(sync);
          },
          { passive: true }
        );
        sync();
      }

      /* ---------------- 入场动效（一次性触发） ---------------- */
      (function revealOnScroll() {
        const items = Array.prototype.slice.call(document.querySelectorAll(".reveal"));
        if (!items.length) return;

        const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (prefersReduced || !("IntersectionObserver" in window)) {
          items.forEach((el) => el.classList.add("is-in"));
          return;
        }

        const STAGGER = 70;
        const MAX_STAGGER = 6;

        function enter(el, delay) {
          if (delay > 0) el.style.transitionDelay = delay + "ms";
          el.classList.add("is-in");
        }

        // 首屏前 2 个元素：加载即入，delay 60ms
        const firstScreen = items.filter((el) => {
          const rect = el.getBoundingClientRect();
          return rect.top < window.innerHeight && rect.bottom > 0;
        });
        const immediate = firstScreen.slice(0, 2);
        immediate.forEach((el, i) => enter(el, 60 * (i + 1)));

        const groupCounts = new Map();
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target;
              obs.unobserve(el);
              const parent = el.parentElement;
              const seen = groupCounts.get(parent) || 0;
              groupCounts.set(parent, seen + 1);
              enter(el, Math.min(seen, MAX_STAGGER - 1) * STAGGER);
            });
          },
          { threshold: 0.15 }
        );

        items.forEach((el) => {
          if (immediate.indexOf(el) === -1) observer.observe(el);
        });
      })();
    })();
  </script>
</body>
</html>
